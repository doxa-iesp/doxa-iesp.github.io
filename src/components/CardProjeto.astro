---
/**
 * Cartão de um projeto do laboratório.
 *
 * O CTA leva SEMPRE à página interna do projeto, nunca direto para o site
 * externo: o visitante deve poder ler o que é o projeto antes de sair do site.
 * O link externo fica na página do projeto.
 */
import { url } from '../lib/url';

interface Props {
  slug: string;
  titulo: string;
  resumo: string;
  periodo?: string;
  imagem?: string;
}

const { slug, titulo, resumo, periodo, imagem } = Astro.props;

const href = url(`/projetos/${slug}/`);
---

<li class="projeto">
  {/* Sem capa, a faixa da marca ocupa o lugar dela. O card precisa da banda: numa
      fileira de dois, o card sem capa esticava até a altura do vizinho e ficava com
      ~300px de branco no miolo, com cara de imagem que não carregou. Mesmo recurso
      do CardMembro para quem não tem foto. */}
  {
    imagem ? (
      <div class="projeto__capa">
        <img src={url(imagem)} alt="" width="640" height="360" loading="lazy" />
      </div>
    ) : (
      <div class="projeto__capa projeto__capa--vazia faixa-marca textura-x" aria-hidden="true" />
    )
  }

  <div class="projeto__corpo">
    {/* Sem etiqueta de status: a página de projetos já agrupa por "Em andamento"
        e "Concluídos", então repeti-la no card seria redundante. */}
    {periodo && <p class="projeto__periodo">{periodo}</p>}

    <h2 class="projeto__titulo">
      <a href={href}>{titulo}</a>
    </h2>
    <p class="projeto__resumo">{resumo}</p>

    <p class="projeto__acao">
      <a href={href}>Conhecer o projeto <span aria-hidden="true">→</span></a>
    </p>
  </div>
</li>

<style>
  .projeto {
    display: flex;
    flex-direction: column;
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-top: 3px solid var(--cor-destaque);
    border-radius: var(--raio-g);
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    transition: box-shadow var(--transicao), transform var(--transicao);
  }
  .projeto:hover {
    box-shadow: var(--sombra-alta);
    transform: translateY(-2px);
  }

  .projeto__capa {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--cor-fundo-alt);
    overflow: hidden;
  }
  .projeto__capa img {
    /* mesma armadilha do CardMembro/CardEvento: sem `absolute`, a proporção da
       imagem vence o aspect-ratio. Aqui ainda não aparecia porque as capas de
       projeto são todas paisagem — mas quebraria na primeira capa vertical. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .projeto__capa--vazia {
    /* o gradiente é o próprio conteúdo da banda */
    background: var(--gradiente-marca);
  }

  .projeto__corpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--esp-3);
  }

  .projeto__periodo {
    margin: 0 0 var(--esp-1);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--cor-texto-suave);
  }

  .projeto__titulo {
    font-size: 1.2rem;
    margin: 0 0 var(--esp-1);
  }
  .projeto__titulo a {
    text-decoration: none;
    color: var(--cor-primaria-escura);
  }
  .projeto__titulo a:hover {
    color: var(--cor-destaque-texto);
  }

  .projeto__resumo {
    color: var(--cor-texto-suave);
    font-size: 0.92rem;
    flex: 1;
  }
  .projeto__acao {
    margin: var(--esp-2) 0 0;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .projeto__acao a {
    text-decoration: none;
  }
</style>
