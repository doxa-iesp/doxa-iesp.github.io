---
/**
 * Página-stub que redireciona uma URL antiga para a nova.
 *
 * POR QUE NÃO USAR `redirects` do astro.config.mjs
 * ------------------------------------------------
 * O Astro monta o destino do redirect só a partir dos segmentos da rota, SEM o
 * `base` (ver `dist/core/routing/generator.js`). Quando o site vivia em
 * `felipelamarca.com/DOXA/`, um `redirects: { '/pesquisas': '/producao/pesquisas' }`
 * mandava o visitante para `felipelamarca.com/producao/pesquisas/` — sem o `/DOXA`
 * — o que dava 404 em produção (e só em produção). Hoje o `base` é vazio e o
 * problema dorme, mas volta no dia em que o site for para um subdiretório.
 *
 * Este componente monta o destino com `url()`, que respeita o base path. Quem o usa
 * é src/pages/[...antiga].astro, a partir da tabela de src/lib/rotas-antigas.mjs.
 */
import { url } from '../lib/url';

interface Props {
  /** Caminho interno de destino, ex.: '/producao/pesquisas/' */
  para: string;
}

const destino = url(Astro.props.para);
/** O canonical vai absoluto (é o que os buscadores esperam); o redirecionamento continua relativo. */
const canonica = new URL(destino, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={canonica} />
    <meta name="robots" content="noindex" />
    <title>Esta página mudou de endereço</title>
  </head>
  <body>
    <p>
      Esta página mudou de endereço. Se você não for redirecionado,{' '}
      <a href={destino}>clique aqui</a>.
    </p>
    <script is:inline define:vars={{ destino }}>
      // O meta refresh já basta; isto só troca a entrada no histórico para que o
      // botão "voltar" não caia de novo no redirecionamento.
      window.location.replace(destino);
    </script>
  </body>
</html>
