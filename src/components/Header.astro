---
import { MENU } from '../lib/navegacao';
import { url, ativo, mesmaPagina } from '../lib/url';

const atual = Astro.url.pathname;
---

<header class="cabecalho">
  <div class="cabecalho__marca">
    <div class="container cabecalho__marca-inner">
      <a href={url('/')} class="cabecalho__logo" aria-label="DOXA, página inicial">
        <img src={url('/img/logo-doxa.svg')} alt="DOXA" width="130" height="40" />
      </a>
      <p class="cabecalho__tagline">
        Laboratório de Estudos Eleitorais, de Comunicação Política e Opinião Pública
      </p>
      <button
        class="cabecalho__toggle"
        aria-expanded="false"
        aria-controls="menu-principal"
        aria-label="Abrir menu de navegação"
      >
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="nav" id="menu-principal" aria-label="Navegação principal">
    <div class="container">
      <ul class="nav__lista">
        {
          MENU.map((item) => {
            const filhoAtivo = item.filhos?.find((f) => ativo(atual, url(f.href)));
            // /seminarios/ e /mapas-de-votacao/ são rotas IRMÃS das capas, não filhas,
            // então a comparação por prefixo não as marcava — nessas duas páginas
            // nenhum item do menu acendia. Aqui o pai acende se ele OU um filho casar.
            const paiAtivo = ativo(atual, url(item.href)) || Boolean(filhoAtivo);
            return (
              <li
                class:list={[
                  'nav__item',
                  item.filhos && 'nav__item--dropdown',
                  filhoAtivo && 'nav__item--expandido',
                ]}
              >
                <a
                  href={url(item.href)}
                  class="nav__link"
                  aria-haspopup={item.filhos ? 'true' : undefined}
                  aria-current={
                    mesmaPagina(atual, url(item.href)) ? 'page' : paiAtivo ? 'true' : undefined
                  }
                >
                  {item.nome}
                  {item.filhos && <span class="nav__seta" aria-hidden="true">▾</span>}
                </a>
                {item.filhos && (
                  <button
                    type="button"
                    class="nav__expandir"
                    aria-expanded={filhoAtivo ? 'true' : 'false'}
                    aria-controls={`submenu-${item.href.replace(/\//g, '') || 'inicio'}`}
                    aria-label={`Mostrar subitens de ${item.nome}`}
                  >
                    <span aria-hidden="true">▾</span>
                  </button>
                )}
                {item.filhos && (
                  <ul class="nav__submenu" id={`submenu-${item.href.replace(/\//g, '') || 'inicio'}`}>
                    {item.filhos.map((f) => (
                      <li class={f.capa ? 'nav__subitem nav__subitem--capa' : 'nav__subitem'}>
                        <a
                          href={url(f.href)}
                          class="nav__sublink"
                          aria-current={mesmaPagina(atual, url(f.href)) ? 'page' : undefined}
                        >
                          {f.nome}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  /* A borda terracota é metade de um par: esta fecha o cabeçalho, a do rodapé
     abre embaixo. A simetria é o efeito. */
  .cabecalho {
    border-bottom: var(--borda-marca) solid var(--cor-destaque);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--sombra-sm);
  }
  .cabecalho__marca {
    background: var(--cor-branco);
  }
  .cabecalho__marca-inner {
    display: flex;
    align-items: center;
    gap: var(--esp-3);
    padding-block: var(--esp-2);
  }
  .cabecalho__tagline {
    margin: 0;
    font-size: 0.78rem;
    color: var(--cor-texto-suave);
    letter-spacing: 0.02em;
    flex: 1;
  }
  .cabecalho__toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: none;
    border: 0;
    /* 44×44 é o alvo mínimo recomendado para toque — este botão tinha 40×30 e é
       o controle mais usado do site no celular. */
    min-width: 44px;
    min-height: 44px;
    padding: 8px;
    cursor: pointer;
  }
  .cabecalho__toggle span {
    width: 24px;
    height: 2px;
    background: var(--cor-primaria);
  }

  /* O gradiente navy→verde é a assinatura da marca. Antes esta barra fazia
     navy→navy-claro e o verde nunca aparecia no site. */
  .nav {
    background: var(--gradiente-marca);
  }
  /* A nav usa o gradiente direto (não a classe .faixa-marca), então precisa da
     mesma correção do anel de foco: terracota sobre navy dá 2,17:1 e some. */
  .nav :focus-visible {
    outline-color: var(--cor-branco);
  }
  .nav__lista {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    display: block;
    padding: 0.85rem 1rem;
    color: var(--cor-branco);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: var(--transicao);
  }
  .nav__link:hover {
    background: rgb(0 0 0 / 18%);
    color: var(--cor-branco);
  }
  /* A aba assimétrica com a faixa terracota à direita é a assinatura do menu do
     site antigo. Antes o item ativo era um cinza translúcido, indistinguível do
     hover. */
  .nav__link[aria-current='page'] {
    background: var(--cor-primaria-escura);
    color: var(--cor-branco);
    border-radius: var(--raio) 18px 0 0;
    border-right: 3px solid var(--cor-destaque);
  }
  .nav__seta {
    display: inline-block;
    font-size: 0.7em;
    margin-left: 4px;
    transition: transform var(--transicao);
  }
  @media (min-width: 901px) {
    .nav__item--dropdown:hover .nav__seta,
    .nav__item--dropdown:focus-within .nav__seta {
      transform: rotate(180deg);
    }
  }

  .nav__submenu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    background: var(--cor-primaria-escura);
    list-style: none;
    margin: 0;
    padding: 0;
    box-shadow: var(--sombra);
    z-index: 20;
    display: none;
  }
  /* Restrito ao desktop com ponteiro: estas regras têm especificidade (0,3,0) e
     venciam tanto o `display: none` do bloco mobile quanto a própria sanfona
     (0,2,0) — no celular o submenu não fechava, e num toque real o `:hover`
     ficava grudado com a seta já girada. */
  @media (min-width: 901px) {
    .nav__item--dropdown:hover > .nav__submenu,
    .nav__item--dropdown:focus-within > .nav__submenu,
    .nav__item--dropdown.aberto > .nav__submenu {
      display: block;
    }
  }
  .nav__sublink {
    display: block;
    padding: 0.7rem 1rem;
    color: var(--cor-branco);
    text-decoration: none;
    font-size: 0.83rem;
  }
  .nav__sublink:hover {
    background: var(--cor-primaria);
    color: var(--cor-branco);
  }
  /* Hierarquia do submenu: o primeiro item é a capa da seção (mesmo destino do
     item pai) e os demais são subtópicos. Sem esta distinção o dropdown do
     desktop era uma lista plana de 5 itens irmãos. */
  .nav__subitem--capa .nav__sublink {
    font-weight: 700;
  }
  .nav__subitem--capa {
    border-bottom: 1px solid rgb(255 255 255 / 18%);
  }
  .nav__subitem:not(.nav__subitem--capa) .nav__sublink {
    padding-left: 1.75rem;
  }
  /* O submenu não indicava em que página você está. */
  .nav__sublink[aria-current='page'] {
    background: rgb(255 255 255 / 10%);
    box-shadow: inset 3px 0 0 var(--cor-destaque);
  }
  /* O botão de expandir só existe no mobile; no desktop o submenu abre no hover
     e no foco, e o item pai continua sendo um link comum. */
  .nav__expandir {
    display: none;
  }

  @media (max-width: 900px) {
    .cabecalho__tagline {
      display: none;
    }
    .cabecalho__toggle {
      display: flex;
      margin-left: auto;
    }
    .nav {
      display: none;
    }
    .nav.aberto {
      display: block;
      /* O cabeçalho é sticky. Com o menu aberto ele chegava a 807px numa tela de
         844px — e elemento sticky mais alto que a viewport trava a rolagem da
         página (era o "scroll bugado"). Aqui o menu ganha altura máxima e rola
         sozinho; `contain` impede que a rolagem vaze para a página atrás. */
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .nav__lista {
      flex-direction: column;
    }
    .nav__item + .nav__item {
      border-top: 1px solid rgb(255 255 255 / 12%);
    }
    /* A aba assimétrica é desenho de desktop: numa linha de largura total ela
       virava uma lasca terracota solta na borda direita. */
    .nav__link[aria-current='page'] {
      border-radius: 0;
      border-right: 0;
      box-shadow: inset 3px 0 0 var(--cor-destaque);
    }
    .nav__link {
      padding: 0.85rem 0;
    }
    /* A seta decorativa dá lugar ao botão de verdade, que expande a seção. */
    .nav__seta {
      display: none;
    }
    .nav__item--dropdown {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .nav__expandir {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      min-height: 44px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--cor-branco);
      font-size: 0.9rem;
      cursor: pointer;
      transition: transform var(--transicao);
    }
    .nav__item--expandido > .nav__expandir {
      transform: rotate(180deg);
    }
    .nav__submenu {
      grid-column: 1 / -1;
      position: static;
      /* Sanfona: sem isto o menu tinha 19 linhas e ocupava a tela inteira. */
      display: none;
      box-shadow: none;
      background: rgb(0 0 0 / 18%);
      /* régua terracota ligando os subitens ao pai */
      border-left: 3px solid var(--cor-destaque);
      margin: 0 0 0.35rem 0.25rem;
      border-radius: 0 var(--raio) var(--raio) 0;
    }
    .nav__item--expandido > .nav__submenu {
      display: block;
    }
    .nav__subitem--capa {
      border-bottom-color: rgb(255 255 255 / 14%);
    }
    .nav__sublink,
    .nav__subitem:not(.nav__subitem--capa) .nav__sublink {
      padding: 0.6rem 1rem 0.6rem 1.1rem;
    }
  }
</style>

<script>
  // Menu mobile. Em telas pequenas os dropdowns já ficam abertos (CSS), então o único
  // comportamento necessário é abrir/fechar a navegação inteira.
  const toggle = document.querySelector<HTMLButtonElement>('.cabecalho__toggle');
  const nav = document.querySelector<HTMLElement>('#menu-principal');

  function fecharMenu() {
    nav?.classList.remove('aberto');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menu de navegação');
  }

  toggle?.addEventListener('click', () => {
    const aberto = nav?.classList.toggle('aberto') ?? false;
    toggle.setAttribute('aria-expanded', String(aberto));
    toggle.setAttribute('aria-label', aberto ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
  });

  // Sanfona do mobile: cada seção com subitens abre e fecha no botão. A seção da
  // página atual já vem aberta (marcada no servidor), para o visitante se localizar.
  document.querySelectorAll<HTMLButtonElement>('.nav__expandir').forEach((botao) => {
    botao.addEventListener('click', () => {
      const item = botao.closest('.nav__item');
      const aberto = item?.classList.toggle('nav__item--expandido') ?? false;
      botao.setAttribute('aria-expanded', String(aberto));
    });
  });

  // Escape fecha o que estiver aberto. No desktop o submenu abre por :focus-within,
  // e sem isto ele ficava preso aberto ao navegar por teclado — o critério 1.4.13
  // do WCAG exige poder dispensar sem mover o foco.
  document.addEventListener('keydown', (evento) => {
    if (evento.key !== 'Escape') return;
    if (nav?.classList.contains('aberto')) {
      fecharMenu();
      toggle?.focus();
      return;
    }
    const foco = document.activeElement as HTMLElement | null;
    const dentro = foco?.closest('.nav__item--dropdown');
    if (dentro) (dentro.querySelector('.nav__link') as HTMLElement | null)?.blur();
  });
</script>
