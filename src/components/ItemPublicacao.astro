---
/**
 * Card de publicação (publicações acadêmicas, análises de conjuntura, textos
 * para discussão).
 *
 * Card branco com uma ABA DE PASTA terracota no topo, título navy e AUTOR EM
 * TERRACOTA, como no site antigo.
 *
 * Ordem dos elementos: título, autor, fonte, AÇÕES (baixar o PDF vem primeiro,
 * é o que o visitante mais quer) e só então o botão que abre o resumo.
 *
 * O resumo abre num pop-up (`<dialog>` nativo) em vez de ocupar o card inteiro:
 * resumos longos faziam um card ficar três vezes mais alto que o vizinho.
 * Sem JavaScript o `<dialog>` não abre, então o resumo continua acessível como
 * texto normal dentro de um `<details>` de reserva.
 *
 * Contraste: o autor usa `--cor-destaque-texto` (5,08:1). O `--cor-destaque`
 * puro dá 3,73:1 sobre branco e reprovaria em AA.
 */
import { linkPara } from '../lib/url';

interface Download {
  rotulo: string;
  url: string;
}
interface Props {
  titulo: string;
  autores?: string;
  ano?: string | number;
  fonte?: string; // editora ou revista
  paginas?: string;
  url?: string;
  resumo?: string;
  etiqueta?: string;
  downloads?: Download[];
}

const {
  titulo,
  autores,
  ano,
  fonte,
  paginas,
  url: link,
  resumo,
  etiqueta,
  downloads = [],
} = Astro.props;

const abaTexto = etiqueta ?? (ano != null ? String(ano) : undefined);
const detalhes = [fonte, paginas].filter((x): x is string => Boolean(x));

// id estável para ligar o botão ao pop-up correspondente
const idResumo = `resumo-${titulo
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')
  .slice(0, 48)}`;
---

<li class="pub">
  {
    abaTexto && (
      <p class="pub__aba">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm0 2.5L17.5 8H14V4.5ZM8 13h8v1.5H8V13Zm0 3.5h8V18H8v-1.5ZM8 9.5h4V11H8V9.5Z" />
        </svg>
        {abaTexto}
      </p>
    )
  }

  <div class="pub__corpo">
    {
      link ? (
        <a class="pub__titulo" href={linkPara(link)} target="_blank" rel="noopener noreferrer">
          {titulo}
        </a>
      ) : (
        <span class="pub__titulo">{titulo}</span>
      )
    }

    {autores && <p class="pub__autores">{autores}</p>}
    {detalhes.length > 0 && <p class="pub__detalhes">{detalhes.join(', ')}</p>}

    {
      (downloads.length > 0 || resumo) && (
        <p class="pub__acoes">
          {downloads.map((d) => (
            <a class="pub__botao pub__botao--baixar" href={linkPara(d.url)} target="_blank" rel="noopener noreferrer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 16 6 10l1.4-1.4 3.6 3.6V3h2v9.2l3.6-3.6L18 10l-6 6Zm-7 4v-2h14v2H5Z" />
              </svg>
              {d.rotulo}
            </a>
          ))}

          {resumo && (
            <button type="button" class="pub__botao pub__resumo-abrir" data-resumo={idResumo} hidden>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4 5h16v2H4V5Zm0 4h16v2H4V9Zm0 4h16v2H4v-2Zm0 4h10v2H4v-2Z" />
              </svg>
              Ler o resumo
            </button>
          )}
        </p>
      )
    }

    {
      /* Reserva sem JavaScript: o pop-up não abre, mas o resumo continua legível. */
      resumo && (
        <details class="pub__resumo-reserva">
          <summary>Ler o resumo</summary>
          <p>{resumo}</p>
        </details>
      )
    }
  </div>

  {
    resumo && (
      <dialog id={idResumo} class="pub__dialogo" aria-labelledby={`${idResumo}-titulo`}>
        <div class="pub__dialogo-cabecalho">
          <h2 id={`${idResumo}-titulo`}>{titulo}</h2>
          <button type="button" class="pub__dialogo-fechar" aria-label="Fechar o resumo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="m12 10.6 5.3-5.3 1.4 1.4-5.3 5.3 5.3 5.3-1.4 1.4-5.3-5.3-5.3 5.3-1.4-1.4 5.3-5.3-5.3-5.3 1.4-1.4 5.3 5.3Z" />
            </svg>
          </button>
        </div>
        {autores && <p class="pub__dialogo-autores">{autores}</p>}
        <p class="pub__dialogo-texto">{resumo}</p>
        {
          downloads.length > 0 && (
            <p class="pub__dialogo-acoes">
              {downloads.map((d) => (
                <a class="btn btn-primario" href={linkPara(d.url)} target="_blank" rel="noopener noreferrer">
                  {d.rotulo}
                </a>
              ))}
            </p>
          )
        }
      </dialog>
    )
  }
</li>

<style>
  .pub {
    display: flex;
    flex-direction: column;
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-g);
    box-shadow: var(--sombra-sm);
    transition: box-shadow var(--transicao), transform var(--transicao);
    overflow: visible;
  }
  .pub:hover {
    box-shadow: var(--sombra-alta);
    transform: translateY(-2px);
  }

  /* A aba de pasta: canto superior-direito arredondado, como no site antigo. */
  .pub__aba {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    align-self: flex-start;
    margin: 0;
    padding: 0.3rem 0.9rem 0.3rem 0.75rem;
    background: var(--cor-destaque);
    color: var(--cor-branco);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: var(--raio-g) 16px 0 0;
  }

  .pub__corpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--esp-2) var(--esp-3) var(--esp-3);
  }

  .pub__titulo {
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.35;
    color: var(--cor-primaria-escura);
    text-wrap: pretty;
  }
  a.pub__titulo {
    color: var(--cor-primaria);
    text-decoration: none;
  }
  a.pub__titulo:hover {
    color: var(--cor-destaque-texto);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Autor em terracota: o detalhe que dava personalidade à página antiga. */
  .pub__autores {
    margin: var(--esp-1) 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cor-destaque-texto);
  }
  .pub__detalhes {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
  }

  .pub__acoes {
    margin: var(--esp-3) 0 0;
    padding-top: var(--esp-2);
    border-top: 1px solid var(--cor-borda);
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-1);
    margin-top: auto;
  }
  .pub__botao {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--cor-primaria);
    background: var(--cor-branco);
    cursor: pointer;
    transition: var(--transicao);
  }
  .pub__botao:hover {
    border-color: var(--cor-primaria);
    background: var(--cor-primaria);
    color: var(--cor-branco);
  }
  /* baixar o PDF é a ação principal */
  .pub__botao--baixar {
    border-color: var(--cor-primaria);
    background: var(--cor-primaria);
    color: var(--cor-branco);
  }
  .pub__botao--baixar:hover {
    background: var(--cor-primaria-escura);
    border-color: var(--cor-primaria-escura);
  }

  /* O <details> só aparece quando o JavaScript não roda; com JS, o script o
     esconde e revela o botão do pop-up. */
  .pub__resumo-reserva {
    margin-top: var(--esp-2);
    font-size: 0.9rem;
    color: var(--cor-texto-suave);
  }
  .pub__resumo-reserva summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--cor-primaria);
  }

  /* ------------------------------------------------------------- pop-up */

  .pub__dialogo {
    width: min(64ch, calc(100vw - 2rem));
    max-height: 85vh;
    padding: var(--esp-4);
    border: 0;
    border-top: 4px solid var(--cor-destaque);
    border-radius: var(--raio-g);
    box-shadow: var(--sombra-alta);
    color: var(--cor-texto);
  }
  .pub__dialogo::backdrop {
    background: rgb(30 58 80 / 55%);
    backdrop-filter: blur(2px);
  }
  .pub__dialogo-cabecalho {
    display: flex;
    align-items: start;
    gap: var(--esp-2);
  }
  .pub__dialogo-cabecalho h2 {
    font-size: 1.2rem;
    margin: 0;
    flex: 1;
  }
  .pub__dialogo-fechar {
    flex: none;
    display: inline-flex;
    padding: 0.35rem;
    border: 0;
    border-radius: var(--raio);
    background: var(--cor-fundo-alt);
    color: var(--cor-texto-suave);
    cursor: pointer;
    transition: var(--transicao);
  }
  .pub__dialogo-fechar:hover {
    background: var(--cor-primaria);
    color: var(--cor-branco);
  }
  .pub__dialogo-autores {
    margin: var(--esp-1) 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cor-destaque-texto);
  }
  .pub__dialogo-texto {
    margin: var(--esp-3) 0 0;
    line-height: 1.7;
    color: var(--cor-texto-suave);
    text-align: justify;
    hyphens: auto;
  }
  .pub__dialogo-acoes {
    margin: var(--esp-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
</style>

<script>
  // Progressive enhancement: sem JavaScript o resumo fica num <details>; com JS,
  // trocamos por um botão que abre o pop-up.
  document.querySelectorAll<HTMLElement>('.pub').forEach((card) => {
    const abrir = card.querySelector<HTMLButtonElement>('.pub__resumo-abrir');
    const reserva = card.querySelector<HTMLDetailsElement>('.pub__resumo-reserva');
    if (!abrir) return;

    const dialogo = document.getElementById(abrir.dataset.resumo ?? '') as HTMLDialogElement | null;
    if (!dialogo || typeof dialogo.showModal !== 'function') return;

    reserva?.remove();
    abrir.hidden = false;

    abrir.addEventListener('click', () => dialogo.showModal());
    dialogo
      .querySelector('.pub__dialogo-fechar')
      ?.addEventListener('click', () => dialogo.close());

    // clicar fora da caixa fecha
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  });
</script>
