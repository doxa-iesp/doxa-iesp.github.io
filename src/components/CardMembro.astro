---
/**
 * Cartão de um membro da equipe.
 *
 * Recupera o desenho do site antigo: foto retangular ocupando o topo, régua
 * terracota, e uma PLAQUETA em gradiente navy→verde com o nome — o sobrenome em
 * terracota claro. Hoje todos os 16 membros têm foto; se algum dia faltar, o card
 * vira só o gradiente com as iniciais e continua elegante.
 *
 * Contraste: o sobrenome usa `--cor-destaque-claro` sobre o gradiente escuro; o
 * `--cor-destaque` puro daria 2,6:1 sobre a ponta verde e reprovaria em AA.
 *
 * Lattes e e-mail são opcionais e só aparecem quando existem de verdade.
 */
import { url } from '../lib/url';
import { partirNome } from '../lib/texto';

interface Props {
  nome: string;
  cargo: string;
  /** Rótulo curto da categoria ("Coordenação", "Associado"…), exibido como etiqueta. */
  funcao?: string;
  foto?: string;
  lattes?: string;
  site?: string;
  email?: string;
}

const { nome, cargo, funcao, foto, lattes, site, email } = Astro.props;

/**
 * O cargo só aparece quando acrescenta alguma coisa. Antes a página tinha um
 * título de seção "Pesquisadores Associados" e, dentro do card, o cargo
 * "Pesquisadora Associada" — a mesma informação duas vezes, em 10 dos 16 cards.
 * Agora a etiqueta carrega a função e o cargo entra só se disser outra coisa
 * ("Doutoranda", "Mestrando", "Bolsista de Treinamento Técnico").
 */
function radicais(texto: string): string[] {
  return texto
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .split(/[^a-z]+/)
    .filter((p) => p.length > 3) // fora "de", "do", "e"
    .map((p) => p.replace(/(ando|anda|ado|ada|os|as|o|a)$/, '')); // gênero e forma verbal
}
/** Duas palavras dizem a mesma coisa se compartilham 7 letras iniciais. */
const parecidas = (x: string, y: string) =>
  x === y || (x.length >= 7 && y.length >= 7 && x.slice(0, 7) === y.slice(0, 7));

const radicaisFuncao = funcao ? radicais(funcao) : [];
const cargoRedundante =
  radicaisFuncao.length > 0 &&
  radicais(cargo).every((c) => radicaisFuncao.some((f) => parecidas(c, f)));
const cargoUtil = cargoRedundante ? '' : cargo;
const [primeiroNome, sobrenome] = partirNome(nome);

/** Iniciais para quando não há foto. */
function iniciais(texto: string): string {
  const partes = texto.trim().split(/\s+/).filter(Boolean);
  const primeira = partes[0]?.[0] ?? '';
  const ultima = partes.length > 1 ? (partes[partes.length - 1]![0] ?? '') : '';
  return (primeira + ultima).toUpperCase();
}
---

<li class="membro">
  <div class="membro__retrato">
    {
      foto ? (
        <img src={url(foto)} alt={`Foto de ${nome}`} width="320" height="320" loading="lazy" />
      ) : (
        <span class="membro__iniciais" aria-hidden="true">
          {iniciais(nome)}
        </span>
      )
    }

    <p class="membro__plaqueta">
      {primeiroNome && <span class="membro__primeiro">{primeiroNome} </span>}<span
        class="membro__sobrenome">{sobrenome}</span
      >
    </p>
  </div>

  <div class="membro__corpo">
    <div class="membro__linha">
      {funcao && <span class="membro__funcao">{funcao}</span>}
      {
        (lattes || site || email) && (
          <ul class="membro__links">
          {lattes && (
            <li>
              <a href={lattes} target="_blank" rel="noopener noreferrer">
                Lattes<span aria-hidden="true"> ↗</span>
              </a>
            </li>
          )}
          {site && (
            <li>
              <a href={site} target="_blank" rel="noopener noreferrer">
                Site<span aria-hidden="true"> ↗</span>
              </a>
            </li>
          )}
            {email && (
              <li>
                <a href={`mailto:${email}`}>E-mail</a>
              </li>
            )}
          </ul>
        )
      }
    </div>
    {/* Linha reservada mesmo vazia: sem ela, os cards de quem não tem cargo
        distinto (ou nenhum link) terminariam numa altura diferente na fileira. */}
    <p class="membro__cargo">{cargoUtil}</p>
  </div>
</li>

<style>
  .membro {
    list-style: none;
    display: flex;
    flex-direction: column;
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-g);
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    transition: box-shadow var(--transicao), transform var(--transicao);
  }
  .membro:hover {
    box-shadow: var(--sombra-alta);
    transform: translateY(-2px);
  }

  .membro__retrato {
    position: relative;
    aspect-ratio: 1 / 1;
    /* sem foto, o próprio gradiente é o fundo do retrato */
    background: var(--gradiente-marca-diag);
    /* a régua terracota entre a foto e a plaqueta */
    border-bottom: 3px solid var(--cor-destaque);
  }
  .membro__retrato img {
    /* `position: absolute` é o que faz o aspect-ratio 1/1 do pai valer. Em fluxo
       normal, `height: 100%` resolve contra altura indefinida e a proporção
       natural da foto vence — era isso que deixava os retratos com 220, 260 e
       274px e desalinhava as plaquetas de nome na mesma fileira. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 22% em vez de `top`: alinha melhor os rostos, que vêm em enquadramentos
       muito diferentes (de 176×144 a 1600×903). */
    object-position: center 22%;
    /* Preto e branco unifica 16 fotos com dominantes conflitantes — selfie ao ar
       livre, retrato em estúdio, foto contra slide projetado. A cor volta no
       hover. Mesmo recurso que a home já usa nos logos dos parceiros. */
    filter: grayscale(1) contrast(1.04);
    transition: filter var(--transicao);
  }
  .membro:hover .membro__retrato img,
  .membro:focus-within .membro__retrato img {
    filter: none;
  }
  .membro__iniciais {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(255 255 255 / 35%);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* A plaqueta sobrepõe o pé da foto. */
  .membro__plaqueta {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 0.55rem var(--esp-2);
    background: var(--gradiente-marca-diag);
    color: var(--cor-branco);
    /* fixo em 0.98rem, um nome de três linhas cobria 59% do retrato num card de
       136px — tapava o rosto. Agora acompanha a largura da tela. */
    font-size: clamp(0.78rem, 0.62rem + 0.8vw, 0.98rem);
    line-height: 1.3;
    text-wrap: balance;
  }
  .membro__primeiro {
    font-weight: 500;
  }
  .membro__sobrenome {
    font-weight: 700;
    color: var(--cor-destaque-claro);
  }

  .membro__corpo {
    flex: 1;
    display: grid;
    grid-template-rows: auto auto;
    gap: 0.3rem;
    padding: 0.6rem 0.9rem 0.75rem;
  }
  .membro__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-height: 1.4rem;
  }
  /* Etiqueta da função. O fundo é 8% do terracota: a 16% o texto em
     --cor-destaque-texto cai para 4,23:1 e reprova em AA; a 8% dá 4,64:1. */
  .membro__funcao {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    /* Sem `nowrap`: o card tem overflow hidden, e a pílula "Pesquisador
       associado" (193px) era decapitada dentro de um card de 136px a 320px —
       lia-se "PESQUISADOR ASS". Agora quebra em duas linhas. */
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    color: var(--cor-destaque-texto);
    background: color-mix(in srgb, var(--cor-destaque) 8%, white);
  }
  .membro__cargo {
    margin: 0;
    /* "Professor/Pesquisador" não cabia em 136px e era cortado na barra */
    overflow-wrap: anywhere;
    font-size: 0.8rem;
    line-height: 1.25;
    min-height: 1rem;
    color: var(--cor-texto-suave);
  }

  .membro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
  }
  .membro__links a {
    /* padding vertical: o alvo tinha 16px de altura, abaixo do mínimo de 24px */
    display: inline-block;
    padding-block: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .membro__links a:hover {
    text-decoration: underline;
  }
</style>
