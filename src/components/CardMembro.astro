---
/**
 * Cartão de um membro da equipe.
 *
 * Recupera o desenho do site antigo: foto retangular ocupando o topo, régua
 * terracota, e uma PLAQUETA em gradiente navy→verde com o nome — o sobrenome em
 * terracota claro. Quando não há foto (12 dos 16 membros), o card vira só o
 * gradiente e continua elegante: era a solução do site antigo para o placeholder.
 *
 * Contraste: o sobrenome usa `--cor-destaque-claro` sobre o gradiente escuro; o
 * `--cor-destaque` puro daria 2,6:1 sobre a ponta verde e reprovaria em AA.
 *
 * Lattes e e-mail são opcionais e só aparecem quando existem de verdade.
 */
import { url } from '../lib/url';
import { partirNome } from '../lib/texto';

interface Props {
  nome: string;
  cargo: string;
  foto?: string;
  lattes?: string;
  site?: string;
  email?: string;
}

const { nome, cargo, foto, lattes, site, email } = Astro.props;
const [primeiroNome, sobrenome] = partirNome(nome);

/** Iniciais para quando não há foto. */
function iniciais(texto: string): string {
  const partes = texto.trim().split(/\s+/).filter(Boolean);
  const primeira = partes[0]?.[0] ?? '';
  const ultima = partes.length > 1 ? (partes[partes.length - 1]![0] ?? '') : '';
  return (primeira + ultima).toUpperCase();
}
---

<li class="membro">
  <div class="membro__retrato">
    {
      foto ? (
        <img src={url(foto)} alt={`Foto de ${nome}`} width="320" height="320" loading="lazy" />
      ) : (
        <span class="membro__iniciais" aria-hidden="true">
          {iniciais(nome)}
        </span>
      )
    }

    <p class="membro__plaqueta">
      {primeiroNome && <span class="membro__primeiro">{primeiroNome} </span>}<span
        class="membro__sobrenome">{sobrenome}</span
      >
    </p>
  </div>

  <div class="membro__corpo">
    <p class="membro__cargo">{cargo}</p>

    {
      (lattes || site || email) && (
        <ul class="membro__links">
          {lattes && (
            <li>
              <a href={lattes} target="_blank" rel="noopener noreferrer">
                Lattes<span aria-hidden="true"> ↗</span>
              </a>
            </li>
          )}
          {site && (
            <li>
              <a href={site} target="_blank" rel="noopener noreferrer">
                Site<span aria-hidden="true"> ↗</span>
              </a>
            </li>
          )}
          {email && (
            <li>
              <a href={`mailto:${email}`}>E-mail</a>
            </li>
          )}
        </ul>
      )
    }
  </div>
</li>

<style>
  .membro {
    list-style: none;
    display: flex;
    flex-direction: column;
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-g);
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    transition: box-shadow var(--transicao), transform var(--transicao);
  }
  .membro:hover {
    box-shadow: var(--sombra-alta);
    transform: translateY(-2px);
  }

  .membro__retrato {
    position: relative;
    aspect-ratio: 1 / 1;
    /* sem foto, o próprio gradiente é o fundo do retrato */
    background: var(--gradiente-marca-diag);
    /* a régua terracota entre a foto e a plaqueta */
    border-bottom: 3px solid var(--cor-destaque);
  }
  .membro__retrato img {
    /* `position: absolute` é o que faz o aspect-ratio 1/1 do pai valer. Em fluxo
       normal, `height: 100%` resolve contra altura indefinida e a proporção
       natural da foto vence — era isso que deixava os retratos com 220, 260 e
       274px e desalinhava as plaquetas de nome na mesma fileira. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .membro__iniciais {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(255 255 255 / 35%);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* A plaqueta sobrepõe o pé da foto. */
  .membro__plaqueta {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 0.55rem var(--esp-2);
    background: var(--gradiente-marca-diag);
    color: var(--cor-branco);
    font-size: 0.98rem;
    line-height: 1.3;
    text-wrap: balance;
  }
  .membro__primeiro {
    font-weight: 500;
  }
  .membro__sobrenome {
    font-weight: 700;
    color: var(--cor-destaque-claro);
  }

  .membro__corpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--esp-2);
  }
  .membro__cargo {
    margin: 0;
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
  }

  .membro__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
    list-style: none;
    margin: var(--esp-2) 0 0;
    padding: 0;
  }
  .membro__links a {
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .membro__links a:hover {
    text-decoration: underline;
  }
</style>
