---
/**
 * Card da vitrine de destaques da home (coleção `destaques`).
 *
 * Deitado de propósito: os destaques costumam ser capa de livro ou cartaz de
 * evento, que são RETRATO. Num card 16:9, como o de evento, a arte seria cortada
 * no meio. Aqui a imagem fica numa coluna estreita à esquerda e o texto ao lado.
 *
 * Todo href passa por `linkPara()`, porque um destaque tanto pode apontar para
 * fora quanto para um arquivo do próprio site (o PDF de um livro, por exemplo).
 */
import { url, linkPara, externo } from '../lib/url';

interface Props {
  titulo: string;
  resumo: string;
  etiqueta?: string;
  imagem?: string;
  url?: string;
  rotulo_url?: string;
}

const { titulo, resumo, etiqueta, imagem, url: link, rotulo_url } = Astro.props;
const ehExterno = link ? externo(link) : false;
---

<li class="destaque">
  {
    imagem && (
      <div class="destaque__arte">
        <img src={url(imagem)} alt="" loading="lazy" width="320" height="400" />
      </div>
    )
  }
  <div class="destaque__corpo">
    {etiqueta && <p class="destaque__etiqueta">{etiqueta}</p>}
    <h3 class="destaque__titulo">{titulo}</h3>
    <p class="destaque__resumo">{resumo}</p>
    {
      link && (
        <p class="destaque__acao">
          <a
            class="btn btn-primario"
            href={linkPara(link)}
            target={ehExterno ? '_blank' : undefined}
            rel={ehExterno ? 'noopener noreferrer' : undefined}
          >
            {rotulo_url ?? 'Acessar'}
            <span aria-hidden="true">{ehExterno ? ' ↗' : ' →'}</span>
          </a>
        </p>
      )
    }
  </div>
</li>

<style>
  .destaque {
    list-style: none;
    display: grid;
    grid-template-columns: 180px 1fr;
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-g);
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    transition: box-shadow var(--transicao);
  }
  .destaque:hover {
    box-shadow: var(--sombra-alta);
  }
  .destaque__arte {
    /* Sem aspect-ratio aqui de propósito: quem define a altura é a coluna de
       texto, e a arte estica para acompanhá-la (a <img> é absoluta). Com
       aspect-ratio fixo sobrava um vazio branco embaixo da capa. */
    position: relative;
    min-height: 200px;
    background: var(--cor-fundo-alt);
    border-right: 1px solid var(--cor-borda);
  }
  .destaque__arte img {
    position: absolute;
    /* `contain`, não `cover`: destaque costuma ser capa de livro ou cartaz, onde
       a arte carrega texto. Recortar cortaria o título da peça. */
    inset: var(--esp-1);
    width: calc(100% - var(--esp-1) * 2);
    height: calc(100% - var(--esp-1) * 2);
    object-fit: contain;
  }
  .destaque__corpo {
    display: flex;
    flex-direction: column;
    padding: var(--esp-3);
  }
  .destaque__etiqueta {
    margin: 0 0 var(--esp-1);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cor-destaque-texto);
  }
  .destaque__titulo {
    margin: 0 0 var(--esp-1);
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--cor-primaria-escura);
    text-wrap: pretty;
  }
  .destaque__resumo {
    margin: 0;
    color: var(--cor-texto-suave);
    font-size: 0.92rem;
  }
  .destaque__acao {
    margin: var(--esp-3) 0 0;
    padding-top: var(--esp-2);
  }

  /* No celular a arte vira uma faixa no topo: 150px de largura numa tela de
     390px comeriam metade da linha de texto. */
  @media (max-width: 560px) {
    /* No celular a arte vira faixa no topo, com recorte pelo alto — a mesma
       solução do card de evento. Com `contain` numa faixa 16:9 a peça (retrato)
       ficava com 125px de largura e 69% da caixa virava cinza; numa coluna
       lateral estreita sobrava vazio vertical. Recortando, a arte preenche e o
       título da peça continua visível. */
    .destaque {
      grid-template-columns: 1fr;
    }
    .destaque__arte {
      aspect-ratio: 16 / 9;
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--cor-borda);
    }
    .destaque__arte img {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
    }
  }
</style>
