---
import type { CollectionEntry } from 'astro:content';
import { normalizar } from '../lib/texto';

interface Props {
  item: CollectionEntry<'acervo'>['data'];
}
const { item } = Astro.props;

// Tokens para o filtro client-side (ver <script> em acervo.astro).
const dataCargo = item.cargo.map(normalizar).join('|');
const dataPartidos = item.partidos.map(normalizar).join('|');
const dataCandidatos = item.candidatos.map(normalizar).join('|');
const dataRegiao = item.regiao ? normalizar(item.regiao) : '';
---

<article
  class="card-acervo"
  data-ano={String(item.ano)}
  data-cargo={dataCargo}
  data-regiao={dataRegiao}
  data-partidos={dataPartidos}
  data-candidatos={dataCandidatos}
>
  <header class="card-acervo__topo">
    <span class="card-acervo__codigo">{item.codigo}</span>
    {item.tipo_video && <span class="card-acervo__tipo">{item.tipo_video}</span>}
  </header>

  <dl class="card-acervo__meta">
    {
      item.data && (
        <div>
          <dt>Data</dt>
          <dd>{item.data}</dd>
        </div>
      )
    }
    <div>
      <dt>Ano</dt>
      <dd>{item.ano}</dd>
    </div>
    {
      item.regiao && (
        <div>
          <dt>Região</dt>
          <dd>{item.regiao}</dd>
        </div>
      )
    }
    {
      item.cargo.length > 0 && (
        <div>
          <dt>Cargo</dt>
          <dd>{item.cargo.join(', ')}</dd>
        </div>
      )
    }
  </dl>

  {/* TODOS os candidatos, sem "e mais N": a busca da página é por candidato, e com
      a lista truncada em 4 buscar "collor" devolvia 31 cards em que o nome só
      aparecia em 7. Cada nome guarda a forma normalizada, para o script destacar
      quem casou com a busca. */}
  {
    item.candidatos.length > 0 && (
      <p class="card-acervo__candidatos">
        <span class="card-acervo__rotulo">Candidatos:</span>{' '}
        {item.candidatos.map((c, i) => (
          <>
            <span class="card-acervo__candidato" data-nome={normalizar(c)}>
              {c}
            </span>
            {i < item.candidatos.length - 1 && ', '}
          </>
        ))}
      </p>
    )
  }

  {/* Partidos recolhidos: eram até 29 siglas à mostra (média de 13), que dominavam o
      card sem ser o que se procura. Com o filtro de partido ativo, o script abre este
      bloco nos cards que casam e destaca a sigla. */}
  {
    item.partidos.length > 0 && (
      <details class="card-acervo__partidos">
        <summary>
          {item.partidos.length} {item.partidos.length === 1 ? 'partido' : 'partidos'}
        </summary>
        <ul aria-label="Partidos">
          {item.partidos.map((p) => (
            <li data-partido={normalizar(p)}>{p}</li>
          ))}
        </ul>
      </details>
    )
  }

  <a
    class="card-acervo__link"
    href={item.url}
    target="_blank"
    rel="noopener noreferrer"
  >
    Assistir no Google Drive
    <span aria-hidden="true">↗</span>
  </a>
</article>

<style>
  .card-acervo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-top: 3px solid var(--cor-destaque);
    border-radius: var(--raio-g);
    padding: var(--esp-3);
    box-shadow: var(--sombra-sm);
    height: 100%;
  }
  /* Filtro client-side: esconder um card não pode ser sobreposto pelo display:flex. */
  .card-acervo[hidden] {
    display: none;
  }

  .card-acervo__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-1);
  }
  .card-acervo__codigo {
    font-weight: 700;
    color: var(--cor-primaria-escura);
    font-size: 1.05rem;
  }
  .card-acervo__tipo {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cor-acento);
    background: color-mix(in srgb, var(--cor-acento) 12%, white);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .card-acervo__meta {
    display: grid;
    /* 120px empilhava os quatro pares numa coluna a 320px; 105px cabe em duas. */
    grid-template-columns: repeat(auto-fit, minmax(min(105px, 100%), 1fr));
    gap: var(--esp-1) var(--esp-2);
    margin: 0;
  }
  .card-acervo__meta dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cor-texto-suave);
  }
  .card-acervo__meta dd {
    margin: 0;
    font-size: 0.9rem;
  }

  .card-acervo__candidatos {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .card-acervo__rotulo {
    font-weight: 700;
    color: var(--cor-texto-suave);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  /* Candidato que casou com a busca. Fundo a 18% do terracota: o texto continua em
     --cor-texto, então o contraste segue o do corpo do card. */
  .card-acervo__candidato.is-match {
    font-weight: 700;
    background: color-mix(in srgb, var(--cor-destaque) 18%, white);
    border-radius: 3px;
    padding-inline: 0.15rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .card-acervo__partidos summary {
    cursor: pointer;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cor-texto-suave);
    /* alvo de toque: a linha do resumo tinha só a altura do texto */
    padding-block: 0.4rem;
  }
  .card-acervo__partidos summary:hover {
    color: var(--cor-primaria);
  }
  .card-acervo__partidos ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin: 0.2rem 0 0;
  }
  .card-acervo__partidos li {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--cor-primaria);
    background: var(--cor-fundo-alt);
    border-radius: var(--raio);
    padding: 0.1rem 0.4rem;
  }
  /* sigla do partido filtrado: navy cheio com texto branco (8,07:1) */
  .card-acervo__partidos li.is-match {
    color: var(--cor-branco);
    background: var(--cor-primaria);
  }

  .card-acervo__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.9rem;
    /* 95 links nesta página: --cor-destaque dá 3,72:1 sobre branco e reprova em AA */
    color: var(--cor-destaque-texto);
    text-decoration: none;
  }
  .card-acervo__link:hover {
    text-decoration: underline;
  }
</style>
