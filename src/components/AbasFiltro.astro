---
/**
 * Abas de filtro reutilizáveis, com busca opcional e aprimoramento progressivo.
 *
 * Sem JavaScript, o bloco fica oculto (`hidden`) e TODOS os itens da lista-alvo
 * aparecem — nada quebra. Com JavaScript, abas e busca surgem e filtram no cliente.
 *
 * Uso:
 *   <AbasFiltro alvo="lista-pesquisas" abas={[{ id: 'todas', rotulo: 'Todas' }, ...]}
 *               busca={{ rotulo: 'Buscar', dica: 'título, autor…' }} />
 *   <ul id="lista-pesquisas">
 *     <li data-filtro-valor="tese" data-busca="texto já normalizado">…</li>
 *   </ul>
 *
 * - A aba com `id: 'todas'` (a primeira) mostra tudo; as demais casam com `data-filtro-valor`.
 * - Com `busca`, o item também precisa casar com o que foi digitado (critério de
 *   `casaBusca()` em src/lib/texto.ts) — aba E busca, e o contador reflete os dois.
 *   O campo começa preenchido com `?busca=` da URL: é assim que os endereços antigos
 *   do WordPress chegam já filtrados (ver src/lib/rotas-antigas.mjs).
 * - Elementos `[data-filtro-grupo]` dentro do alvo (um ano, por exemplo) somem quando
 *   nenhum item deles está visível — sem isso, filtrar deixaria títulos órfãos.
 * Os botões são botões de alternância (`aria-pressed`) num grupo, navegáveis por Tab. Até
 * 2026-09-14 usavam `role="tab"`, mas não existe painel de aba (`role="tabpanel"`): é um filtro
 * sobre a mesma lista, e o padrão de abas prometia ao leitor de tela algo que a página não tem.
 */
interface Aba {
  id: string;
  rotulo: string;
}
interface Props {
  alvo: string; // id do container cujos filhos têm data-filtro-valor
  abas: Aba[];
  rotuloGrupo?: string; // aria-label do conjunto de abas
  busca?: { rotulo: string; dica?: string };
}

const { alvo, abas, rotuloGrupo = 'Filtrar itens', busca } = Astro.props;
---

<div class="abas" data-abas data-alvo={alvo} hidden>
  {
    busca && (
      <div class="abas__busca">
        <label for={`busca-${alvo}`}>{busca.rotulo}</label>
        <input
          type="search"
          id={`busca-${alvo}`}
          data-busca-campo
          placeholder={busca.dica}
          enterkeyhint="search"
          autocomplete="off"
        />
      </div>
    )
  }
  <div class="abas__lista" role="group" aria-label={rotuloGrupo}>
    {
      abas.map((aba, i) => (
        <button
          type="button"
          id={`aba-${alvo}-${aba.id}`}
          class="aba"
          data-filtro={aba.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-controls={alvo}
        >
          {aba.rotulo}
        </button>
      ))
    }
  </div>
  <p class="abas__status" role="status" aria-live="polite">
    <span data-status-texto></span>
    <button type="button" class="abas__limpar" data-limpar hidden>Limpar busca</button>
  </p>
</div>

<script>
  import { casaBusca } from '../lib/texto';

  document.querySelectorAll<HTMLElement>('[data-abas]').forEach((raiz) => {
    const alvoId = raiz.getAttribute('data-alvo');
    const alvo = alvoId ? document.getElementById(alvoId) : null;
    if (!alvo) return;

    const abas = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
    const itens = Array.from(alvo.querySelectorAll<HTMLElement>('[data-filtro-valor]'));
    const grupos = Array.from(alvo.querySelectorAll<HTMLElement>('[data-filtro-grupo]'));
    const campo = raiz.querySelector<HTMLInputElement>('[data-busca-campo]');
    const statusTexto = raiz.querySelector<HTMLElement>('[data-status-texto]');
    const limpar = raiz.querySelector<HTMLButtonElement>('[data-limpar]');
    if (abas.length === 0 || itens.length === 0) return;

    // Sem JS o bloco fica oculto; agora que há JS, mostramos.
    raiz.hidden = false;

    let filtro = abas[0]?.getAttribute('data-filtro') ?? 'todas';

    function aplicar() {
      const consulta = campo?.value ?? '';
      let visiveis = 0;
      itens.forEach((el) => {
        const naAba = filtro === 'todas' || el.getAttribute('data-filtro-valor') === filtro;
        const mostra = naAba && casaBusca(el.dataset.busca ?? '', consulta);
        el.hidden = !mostra;
        if (mostra) visiveis += 1;
      });
      grupos.forEach((g) => {
        g.hidden = !g.querySelector('[data-filtro-valor]:not([hidden])');
      });

      const buscando = consulta.trim() !== '';
      if (limpar) limpar.hidden = !buscando;
      if (statusTexto) {
        statusTexto.textContent =
          visiveis === 0
            ? `Nenhum item encontrado${buscando ? ` para “${consulta.trim()}”` : ''}.`
            : visiveis === itens.length
              ? `Mostrando todos os ${itens.length} itens.`
              : `Mostrando ${visiveis} de ${itens.length} itens.`;
      }
    }

    function selecionar(aba: HTMLButtonElement) {
      abas.forEach((t) => {
        t.setAttribute('aria-pressed', t === aba ? 'true' : 'false');
      });
      filtro = aba.getAttribute('data-filtro') ?? 'todas';
      aplicar();
    }

    abas.forEach((aba) => {
      aba.addEventListener('click', () => selecionar(aba));
    });

    if (campo) {
      const inicial = new URLSearchParams(location.search).get('busca');
      if (inicial) campo.value = inicial;
      campo.addEventListener('input', aplicar);
    }
    limpar?.addEventListener('click', () => {
      if (campo) {
        campo.value = '';
        campo.focus();
      }
      aplicar();
    });

    // Estado inicial: sem isto o contador só aparecia depois do primeiro clique,
    // então quem chegava na página não via quantos itens a lista tem.
    aplicar();
  });
</script>

<style>
  .abas {
    margin-bottom: var(--esp-3);
  }
  .abas__busca {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 32rem;
    margin-bottom: var(--esp-2);
  }
  /* Mesmo desenho do campo de busca do acervo (FiltrosAcervo.astro). */
  .abas__busca label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cor-texto-suave);
  }
  .abas__busca input {
    font: inherit;
    line-height: 1.2;
    min-height: 44px;
    appearance: none;
    -webkit-appearance: none;
    font-size: 0.95rem;
    color: var(--cor-texto);
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio);
    padding: 0.55rem 0.7rem;
    width: 100%;
  }
  .abas__busca input:focus-visible {
    border-color: var(--cor-primaria);
  }
  .abas__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-1);
  }
  .aba {
    font: inherit;
    cursor: pointer;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--cor-borda);
    border-radius: 999px;
    background: var(--cor-branco);
    color: var(--cor-primaria);
    font-weight: 600;
    font-size: 0.9rem;
    transition: var(--transicao);
  }
  .aba:hover {
    border-color: var(--cor-primaria);
  }
  .aba[aria-pressed='true'] {
    background: var(--cor-primaria);
    border-color: var(--cor-primaria);
    color: var(--cor-branco);
  }
  .abas__status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--esp-2);
    margin: var(--esp-1) 0 0;
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
  }
  .abas__limpar {
    font: inherit;
    font-weight: 600;
    color: var(--cor-primaria);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    cursor: pointer;
    text-decoration: underline;
  }
  .abas__limpar[hidden] {
    display: none;
  }
  .abas__limpar:hover {
    color: var(--cor-destaque-texto);
  }
</style>
