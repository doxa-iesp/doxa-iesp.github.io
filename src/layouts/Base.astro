---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  titulo: string;
  descricao?: string;
}

const { titulo, descricao } = Astro.props;
const DESC_PADRAO =
  'Laboratório de Estudos Eleitorais, de Comunicação Política e Opinião Pública do IESP-UERJ.';
const desc = descricao ?? DESC_PADRAO;
const tituloCompleto =
  titulo === 'DOXA' ? 'DOXA | Laboratório de Estudos Eleitorais' : `${titulo} | DOXA`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/svg+xml" href={url('/img/logo-doxa.svg')} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    {/* Sem og:image, todo link compartilhado no WhatsApp ou no LinkedIn saía como
        um retângulo cinza. A URL precisa ser absoluta para os validadores. */}
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL(url('/img/og-doxa.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
  </head>
  <body>
    <a href="#conteudo" class="pular-nav">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
