---
import { getEntry } from 'astro:content';
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  /** Nome da página; o <title> vira "Nome | DOXA". Ignorado com `inicio`. */
  titulo: string;
  descricao?: string;
  /** Página inicial: o <title> é o `titulo` de src/data/site.yaml, inteiro. */
  inicio?: boolean;
  /**
   * `false` na página 404: ela é servida em qualquer endereço inexistente, então não
   * tem endereço canônico — sem isto, anunciava `https://lab-doxa.org.br/404/`, que
   * responde 404, e buscadores podiam indexá-la.
   */
  indexavel?: boolean;
}

const { titulo, descricao, inicio = false, indexavel = true } = Astro.props;
// Título da home e descrição padrão vêm de site.yaml (antes estavam escritos aqui e lá, com
// textos diferentes, e o de lá não era lido por ninguém).
const geral = (await getEntry('configuracao', 'geral'))!.data;
const desc = descricao ?? geral.descricao;
const tituloCompleto = inicio ? geral.titulo : `${titulo} | DOXA`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    {indexavel ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/img/logo-doxa.svg')} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DOXA" />
    <meta property="og:locale" content="pt_BR" />
    {/* Sem og:image, todo link compartilhado no WhatsApp ou no LinkedIn saía como
        um retângulo cinza. A URL precisa ser absoluta para os validadores. */}
    {indexavel && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={new URL(url('/img/og-doxa.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
  </head>
  <body>
    <a href="#conteudo" class="pular-nav">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
