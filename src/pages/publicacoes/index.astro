---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../lib/url';

const pagina = (await getEntry('paginas', 'publicacoes'))!;
const { Content } = await render(pagina);

const cards = [
  {
    titulo: 'Publicações Acadêmicas',
    texto: 'Livros, capítulos e artigos em revistas científicas.',
    href: '/publicacoes/academicas/',
  },
  {
    titulo: 'Análises de Conjuntura Eleitoral',
    texto: 'Textos produzidos em períodos eleitorais sobre campanhas, debates e cobertura.',
    href: '/publicacoes/analises-de-conjuntura/',
  },
  {
    titulo: 'Textos para Discussão',
    texto: 'Working papers do laboratório em versão preliminar.',
    href: '/publicacoes/textos-para-discussao/',
  },
];
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao}>
  <PageHero titulo={pagina.data.titulo} subtitulo={pagina.data.descricao} />

  <section class="secao">
    <div class="container">
      <div class="prosa"><Content /></div>
    </div>
  </section>

  <section class="secao secao--alt">
    <div class="container">
      <h2>Explore por tipo</h2>
      <ul class="cards">
        {
          cards.map((c) => (
            <li class="card">
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
              <a class="card__link" href={url(c.href)}>
                Ver publicações <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .prosa {
    max-width: 68ch;
  }
  .prosa :global(h2) {
    margin-top: var(--esp-3);
    font-size: 1.2rem;
    color: var(--cor-primaria);
  }
  .prosa :global(h2:first-child) {
    margin-top: 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--esp-3);
    list-style: none;
    padding: 0;
    margin: var(--esp-3) 0 0;
  }
  .card {
    background: var(--cor-branco);
    border-radius: var(--raio-g);
    padding: var(--esp-3);
    border-top: 3px solid var(--cor-destaque);
    box-shadow: var(--sombra-sm);
  }
  .card h3 {
    margin-bottom: var(--esp-1);
  }
  .card p {
    color: var(--cor-texto-suave);
    font-size: 0.92rem;
  }
  .card__link {
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .card__link:hover {
    text-decoration: underline;
  }
</style>
