---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CardEvento from '../components/CardEvento.astro';

const pagina = (await getEntry('paginas', 'eventos'))!;
const { Content } = await render(pagina);

// Mais recentes primeiro. `data` é Date (z.coerce.date no schema). Mesma data: por título.
const eventos = (await getCollection('eventos')).sort(
  (a, b) =>
    b.data.data.getTime() - a.data.data.getTime() ||
    a.data.titulo.localeCompare(b.data.titulo, 'pt-BR'),
);
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao}>
  <PageHero titulo={pagina.data.titulo} subtitulo={pagina.data.descricao} />

  <section class="secao">
    <div class="container">
      {/* A página de eventos não tem texto de introdução hoje; sem o teste, sobrava uma caixa vazia. */}
      {
        pagina.body?.trim() && (
          <div class="prosa prosa--medida">
            <Content />
          </div>
        )
      }

      {
        eventos.length > 0 ? (
          <ul class="eventos-grid">
            {eventos.map((e) => (
              <CardEvento
                titulo={e.data.titulo}
                data={e.data.data}
                descricao={e.data.descricao}
                imagem={e.data.imagem}
                url={e.data.url}
                anexos={e.data.anexos}
              />
            ))}
          </ul>
        ) : (
          <p>Nenhum evento cadastrado no momento.</p>
        )
      }
    </div>
  </section>
</Base>

<style>

  .eventos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--esp-3);
    list-style: none;
    padding: 0;
    margin: var(--esp-3) 0 0;
  }
</style>
