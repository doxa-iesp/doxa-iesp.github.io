---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ItemPublicacao from '../../components/ItemPublicacao.astro';
import Titulo from '../../components/Titulo.astro';
import { url } from '../../lib/url';

const analises = await getCollection('analises');

// Agrupa por ciclo (ano eleitoral), do mais recente para o mais antigo.
const ciclos = [...new Set(analises.map((a) => a.data.ciclo))].sort((a, b) => b.localeCompare(a));

const grupos = ciclos.map((ciclo) => ({
  ciclo,
  // Dentro do ciclo, a ordem do arquivo — a do site antigo (o id começa pela posição).
  itens: analises.filter((a) => a.data.ciclo === ciclo).sort((a, b) => a.id.localeCompare(b.id)),
}));
---

<Base
  titulo="Análises de Conjuntura Eleitoral"
  descricao="Textos produzidos pelo DOXA em períodos eleitorais, ciclo a ciclo."
>
  <PageHero
    titulo="Análises de Conjuntura Eleitoral"
    subtitulo="Textos produzidos em períodos eleitorais sobre as diferentes etapas e dimensões da campanha."
  />

  <section class="secao">
    <div class="container">
      <p class="voltar"><a href={url('/producao/')}>← Toda a produção</a></p>

      {
        grupos.map((grupo) => (
          <section class="grupo">
            <Titulo nivel="h2" titulo={`Eleições ${grupo.ciclo}`} class="titulo-secao" />
            <ul class="grade-cards grade-cards--larga">
              {grupo.itens.map((a) => (
                <ItemPublicacao
                  titulo={a.data.titulo}
                  fonte={a.data.periodo}
                  resumo={a.data.descricao}
                  downloads={a.data.arquivos}
                  etiqueta={a.data.ciclo}
                />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>

  .grupo {
    margin-top: var(--esp-4);
  }
  .grupo:first-of-type {
    margin-top: 0;
  }
  /* Duas colunas, não três. Os ciclos têm 10, 8, 4, 4, 1 e 1 análises: em três
     colunas os pares deixavam card órfão e os solitários ocupavam um terço da linha,
     com dois terços vazios. Em duas, os grupos pares fecham as linhas e o solitário
     ocupa meia. Não é `.grade-cards--preenche`: com um item só, ele viraria um card
     de 1108px. Só ajusta o gancho que a grade global expõe. */
  .grupo .grade-cards {
    --card-min: 400px;
  }
</style>
