---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const pagina = (await getEntry('paginas', 'pesquisa-covid'))!;
const { Content } = await render(pagina);
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao}>
  <PageHero titulo={pagina.data.titulo} subtitulo={pagina.data.descricao} />

  <section class="secao">
    <div class="container">
      <article class="prosa"><Content /></article>
    </div>
  </section>
</Base>

<style>
  .prosa {
    max-width: 68ch;
  }
  .prosa :global(h2) {
    margin-top: var(--esp-4);
    font-size: 1.2rem;
    color: var(--cor-primaria);
  }
  .prosa :global(h2:first-child) {
    margin-top: 0;
  }
  .prosa :global(p) {
    color: var(--cor-texto);
  }
  .prosa :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
