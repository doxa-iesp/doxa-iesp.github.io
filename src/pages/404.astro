---
/**
 * Página de erro 404.
 *
 * Sem este arquivo, quem erra a URL cai na página genérica do GitHub Pages —
 * sem cabeçalho, sem menu e sem caminho de volta. O Pages usa `404.html` da raiz
 * do site automaticamente, então basta a rota existir.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { url } from '../lib/url';

const caminhos = [
  { nome: 'Início', href: '/' },
  { nome: 'Produção', href: '/producao/' },
  { nome: 'Projetos', href: '/projetos/' },
  { nome: 'Acervo', href: '/acervo/' },
  { nome: 'Bancos de Dados', href: '/bancos-de-dados/' },
  { nome: 'Equipe', href: '/institucional/' },
];
---

<Base
  titulo="Página não encontrada"
  descricao="A página que você procura não existe neste site."
  indexavel={false}
>
  <PageHero
    titulo="Página não encontrada"
    tituloForte="encontrada"
    subtitulo="O endereço que você digitou não existe, ou a página mudou de lugar."
  />

  <section class="secao">
    <div class="container">
      <p id="redirecionando" class="redirecionando" role="status" hidden>
        Este endereço é do site antigo do DOXA. Levando você para onde o conteúdo está agora…
      </p>
      <div class="prosa">
        <p>
          Se você chegou por um link antigo do site anterior, o conteúdo provavelmente continua
          aqui, em outro endereço. Estes são os caminhos principais:
        </p>
      </div>
      <ul class="caminhos">
        {
          caminhos.map((c) => (
            <li>
              <a href={url(c.href)}>{c.nome}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  // Endereços antigos do WordPress que seguem um padrão (/acervo-doxa/<item>/,
  // /partidos/<sigla>/, /wp-content/uploads/…/<arquivo>.pdf…) não existem como página:
  // chegam aqui, e este script manda para o lugar novo. Os de destino exato já são
  // páginas-stub e nem passam pela 404. Tabela e regras: src/lib/rotas-antigas.mjs.
  import { destinoAntigo, nomeDeArquivoAntigo } from '../lib/rotas-antigas.mjs';
  import { url } from '../lib/url';

  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const caminho = location.pathname.slice(BASE.length) || '/';

  function irPara(destino: string) {
    const aviso = document.getElementById('redirecionando');
    if (aviso) aviso.hidden = false;
    location.replace(destino);
  }

  const arquivo = nomeDeArquivoAntigo(caminho);
  if (arquivo) {
    // A tabela de arquivos só é baixada quando o endereço é de fato um arquivo antigo.
    fetch(url('/arquivos-antigos.json'))
      .then((r) => (r.ok ? r.json() : {}))
      .then((tabela: Record<string, string>) => {
        if (tabela[arquivo]) irPara(tabela[arquivo]);
      })
      .catch(() => {});
  } else {
    const destino = destinoAntigo(caminho);
    if (destino) irPara(url(destino));
  }
</script>

<style>
  .redirecionando {
    margin: 0 0 var(--esp-3);
    padding: var(--esp-2) var(--esp-3);
    background: color-mix(in srgb, var(--cor-primaria) 6%, white);
    border-left: 4px solid var(--cor-primaria);
    border-radius: var(--raio);
    font-weight: 600;
  }
  .redirecionando[hidden] {
    display: none;
  }
  .caminhos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
    list-style: none;
    padding: 0;
    margin: var(--esp-3) 0 0;
  }
  .caminhos a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .caminhos a:hover {
    border-color: var(--cor-primaria);
    background: var(--cor-primaria);
    color: var(--cor-branco);
  }
</style>
