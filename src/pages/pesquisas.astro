---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AbasFiltro from '../components/AbasFiltro.astro';

const pagina = (await getEntry('paginas', 'pesquisas'))!;
const { Content } = await render(pagina);

const pesquisas = await getCollection('pesquisas');

// Lista única e plana, ordenada por ano (mais recente primeiro; sem ano vai ao fim).
// As abas apenas escondem/mostram itens por status — cada item traz sua própria etiqueta.
const ordenadas = [...pesquisas].sort(
  (a, b) =>
    (b.data.ano ?? 0) - (a.data.ano ?? 0) ||
    a.data.titulo.localeCompare(b.data.titulo, 'pt-BR'),
);

const ROTULO_STATUS: Record<string, string> = {
  tese: 'Tese / Dissertação',
  andamento: 'Em andamento',
  concluida: 'Concluída',
};

const abas = [
  { id: 'todas', rotulo: 'Todas' },
  { id: 'tese', rotulo: 'Teses e Dissertações' },
  { id: 'andamento', rotulo: 'Em Andamento' },
  { id: 'concluida', rotulo: 'Concluídas' },
];
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao}>
  <PageHero titulo={pagina.data.titulo} subtitulo={pagina.data.descricao} />

  <section class="secao">
    <div class="container">
      <div class="prosa prosa--intro"><Content /></div>

      <AbasFiltro alvo="lista-pesquisas" abas={abas} rotuloGrupo="Filtrar pesquisas por tipo" />

      <ul id="lista-pesquisas" class="pesquisas" aria-label="Pesquisas do DOXA">
        {
          ordenadas.map((p) => {
            const meta = [
              p.data.ano ? String(p.data.ano) : undefined,
              p.data.orientador ? `Orientação: ${p.data.orientador}` : undefined,
              p.data.instituicao,
            ].filter(Boolean);
            return (
              <li class="pesquisa" data-filtro-valor={p.data.status}>
                <span class="pesquisa__tag" data-status={p.data.status}>
                  {ROTULO_STATUS[p.data.status]}
                </span>
                <h2 class="pesquisa__titulo">{p.data.titulo}</h2>
                {p.data.autor && <p class="pesquisa__autor">{p.data.autor}</p>}
                {meta.length > 0 && <p class="pesquisa__meta">{meta.join(' · ')}</p>}
                {p.data.url && (
                  <a
                    class="pesquisa__link"
                    href={p.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Acessar o texto <span aria-hidden="true">→</span>
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Prosa introdutória: esconde o primeiro título, que repetiria o título do herói. */
  .prosa {
    max-width: 68ch;
    color: var(--cor-texto-suave);
    margin-bottom: var(--esp-4);
  }
  .prosa--intro > :global(:is(h1, h2):first-child) {
    display: none;
  }

  .pesquisas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--esp-2);
  }
  .pesquisa {
    display: block;
    padding: var(--esp-3);
    background: var(--cor-branco);
    border: 1px solid var(--cor-borda);
    border-left: 3px solid var(--cor-destaque);
    border-radius: var(--raio-g);
  }
  /* O atributo [hidden] precisa vencer o display do card. */
  .pesquisa[hidden] {
    display: none;
  }
  .pesquisa__tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: var(--esp-1);
    color: var(--cor-branco);
    background: var(--cor-primaria);
  }
  .pesquisa__tag[data-status='andamento'] {
    background: var(--cor-acento);
  }
  .pesquisa__tag[data-status='concluida'] {
    background: var(--cor-texto-suave);
  }
  .pesquisa__titulo {
    font-size: 1.05rem;
    margin: 0 0 var(--esp-1);
    color: var(--cor-primaria-escura);
  }
  .pesquisa__autor {
    margin: 0;
    font-weight: 600;
    color: var(--cor-texto);
  }
  .pesquisa__meta {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--cor-texto-suave);
  }
  .pesquisa__link {
    display: inline-block;
    margin-top: var(--esp-2);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .pesquisa__link:hover {
    text-decoration: underline;
  }
</style>
