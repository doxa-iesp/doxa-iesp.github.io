---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AbasFiltro from '../components/AbasFiltro.astro';
import Titulo from '../components/Titulo.astro';
import { linkPara } from '../lib/url';

const pagina = (await getEntry('paginas', 'na-midia'))!;
const { Content } = await render(pagina);

const midia = await getCollection('midia');

const TIPOS = {
  impressa: 'Impressa',
  virtual: 'Virtual',
  audiovisual: 'Audiovisual',
} as const;

/** "2022-04-24" -> "24/04". Só o ano ("2010") não tem dia a mostrar: o ano já é o subtítulo. */
function diaMes(data?: string): string {
  const completa = data?.match(/^\d{4}-(\d{2})-(\d{2})$/);
  return completa ? `${completa[2]}/${completa[1]}` : '';
}

// Uma lista só, por ano. Antes eram três seções por tipo, cada uma em ordem de data:
// quem procurava "o que saiu em 2020" tinha de olhar três lugares. O tipo virou
// etiqueta no item e aba no topo. Acordeão por ano foi descartado: seriam 22 blocos,
// 10 deles com um item só — mais clique que conteúdo.
const SEM_DATA = 'Sem data';
const porAno = new Map<string, typeof midia>();
for (const m of midia) {
  const ano = m.data.data?.slice(0, 4) ?? SEM_DATA;
  if (!porAno.has(ano)) porAno.set(ano, []);
  porAno.get(ano)!.push(m);
}
const anos = [...porAno.entries()]
  .sort(([a], [b]) => (a === SEM_DATA ? 1 : b === SEM_DATA ? -1 : b.localeCompare(a)))
  .map(([ano, itens]) => ({
    ano,
    // data completa desc; os que só têm o ano vão para o fim do grupo
    itens: [...itens].sort((a, b) => (b.data.data ?? '').localeCompare(a.data.data ?? '')),
  }));

const contagem = (tipo: keyof typeof TIPOS) => midia.filter((m) => m.data.tipo === tipo).length;
const abas = [
  { id: 'todas', rotulo: `Todas (${midia.length})` },
  ...(Object.keys(TIPOS) as (keyof typeof TIPOS)[]).map((tipo) => ({
    id: tipo,
    rotulo: `${TIPOS[tipo]} (${contagem(tipo)})`,
  })),
];
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao}>
  <PageHero titulo={pagina.data.titulo} subtitulo={pagina.data.descricao} />

  <section class="secao">
    <div class="container">
      <div class="prosa prosa--intro"><Content /></div>

      <AbasFiltro alvo="lista-midia" abas={abas} rotuloGrupo="Filtrar por tipo de mídia" />

      <div id="lista-midia">
        {
          anos.map(({ ano, itens }) => (
            <section class="ano" data-filtro-grupo>
              <Titulo nivel="h2" titulo={ano} class="titulo-secao ano__titulo" />
              <ul class="midia">
                {itens.map((m) => {
                  const meta = [m.data.autores, m.data.veiculo].filter(Boolean);
                  const dia = diaMes(m.data.data);
                  return (
                    <li class="item" data-filtro-valor={m.data.tipo}>
                      <span class="item__lado">
                        {dia && <span class="item__data">{dia}</span>}
                        <span class="etiqueta item__tipo">{TIPOS[m.data.tipo]}</span>
                      </span>
                      <span class="item__corpo">
                        {m.data.url ? (
                          <a
                            class="item__titulo"
                            href={linkPara(m.data.url)}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {m.data.titulo}
                          </a>
                        ) : (
                          <span class="item__titulo item__titulo--simples">{m.data.titulo}</span>
                        )}
                        {meta.length > 0 && <span class="item__meta">{meta.join(' · ')}</span>}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* Os 12 subtítulos de ano são marcos de navegação, não seções: menores e mais
     próximos que um `.titulo-secao` comum. No tamanho cheio, somavam ~1.200px. */
  .ano + .ano {
    margin-top: var(--esp-3);
  }
  /* O [hidden] das abas precisa vencer o display dos blocos. */
  .ano[hidden],
  .item[hidden] {
    display: none;
  }
  .ano__titulo {
    font-size: 1.35rem;
    margin-bottom: 0;
  }

  .midia {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item {
    display: grid;
    grid-template-columns: 8.75rem minmax(0, 1fr);
    gap: 0 var(--esp-2);
    padding-block: var(--esp-2);
    border-bottom: 1px solid var(--cor-borda);
  }
  /* Data e etiqueta lado a lado: empilhadas, cada linha ganhava ~25px e a página
     inteira, mais de 1.000px. */
  .item__lado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-self: start;
    gap: 0.2rem var(--esp-1);
    padding-top: 0.1rem;
  }
  .item__data {
    color: var(--cor-texto-suave);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .item__tipo {
    font-size: 0.64rem;
    /* com o 1.7 herdado, a etiqueta ficava mais alta que a data ao lado */
    line-height: 1.3;
  }
  .item__corpo {
    display: flex;
    flex-direction: column;
  }
  .item__titulo {
    font-weight: 600;
    /* sem isto, o título herda o 1.7 do body: 27px de entrelinha num título de
       duas linhas, que deixa de se ler como um bloco */
    line-height: 1.35;
  }
  /* 70 sublinhados cheios formavam uma parede, mas sem NENHUM sinal o link e o
     não-link se distinguiam só pela cor (1,97:1 entre eles). Sublinhado suave:
     presente, discreto, e cheio no hover. */
  a.item__titulo {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    text-underline-offset: 3px;
  }
  a.item__titulo:hover {
    text-decoration-color: currentColor;
  }
  /* Sem link: era navy escuro, quase igual ao azul de link — parecia link quebrado. */
  .item__titulo--simples {
    color: var(--cor-texto);
    font-weight: 500;
  }
  .item__meta {
    color: var(--cor-texto-suave);
    font-size: 0.9rem;
  }

  @media (max-width: 520px) {
    .item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
</style>
