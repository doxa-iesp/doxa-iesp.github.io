---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { url, linkPara, externo } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projetos = await getCollection('projetos');
  return projetos.map((p) => ({ params: { slug: p.id }, props: { projeto: p } }));
}) satisfies GetStaticPaths;

const { projeto } = Astro.props;
const { Content } = await render(projeto);
const d = projeto.data;

const ROTULO_STATUS: Record<string, string> = {
  ativo: 'Em andamento',
  concluido: 'Concluído',
};
---

<Base titulo={d.titulo} descricao={d.resumo}>
  <PageHero titulo={d.titulo} subtitulo={d.resumo} />

  <section class="secao">
    <div class="container">
      <p class="voltar"><a href={url('/projetos/')}>← Todos os projetos</a></p>

      {
        (d.status || d.periodo) && (
          <p class="meta">
            {d.status && (
              <span class:list={['etiqueta', d.status === 'ativo' && 'etiqueta--ativo']}>
                {ROTULO_STATUS[d.status]}
              </span>
            )}
            {d.periodo && <span class="meta__periodo">{d.periodo}</span>}
          </p>
        )
      }

      <div class="prosa"><Content /></div>

      {
        (d.url || d.links.length > 0) && (
          <div class="acoes">
            {d.url && (
              <a class="btn btn-primario" href={d.url} target="_blank" rel="noopener noreferrer">
                {d.rotulo_url ?? 'Acessar o projeto'} <span aria-hidden="true">↗</span>
              </a>
            )}
            {d.links.map((l) => {
              const fora = externo(l.url);
              return (
                <a
                  class="btn btn-contorno"
                  href={linkPara(l.url)}
                  target={fora ? '_blank' : undefined}
                  rel={fora ? 'noopener noreferrer' : undefined}
                >
                  {l.rotulo}
                  {fora && <span aria-hidden="true"> ↗</span>}
                </a>
              );
            })}
          </div>
        )
      }

      {
        d.embed && (
          <div class="painel">
            <iframe
              src={d.embed}
              title={`Painel interativo — ${d.titulo}`}
              loading="lazy"
              allowfullscreen
            />
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-2);
    margin: 0 auto var(--esp-3);
    max-width: var(--largura-prosa);
  }
  .meta__periodo {
    font-size: 0.9rem;
    color: var(--cor-texto-suave);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
    margin: var(--esp-4) auto 0;
    max-width: var(--largura-prosa);
  }

  .painel {
    margin-top: var(--esp-4);
    aspect-ratio: 16 / 10;
    border-radius: var(--raio-g);
    overflow: hidden;
    box-shadow: var(--sombra);
    background: var(--cor-fundo-alt);
  }
  .painel iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
