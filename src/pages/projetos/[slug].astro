---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { url, linkPara, externo } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projetos = await getCollection('projetos');
  return projetos.map((p) => ({ params: { slug: p.id }, props: { projeto: p } }));
}) satisfies GetStaticPaths;

const { projeto } = Astro.props;
const { Content } = await render(projeto);
const d = projeto.data;

const ROTULO_STATUS: Record<string, string> = {
  ativo: 'Em andamento',
  concluido: 'Concluído',
};
---

<Base titulo={d.titulo} descricao={d.resumo}>
  <PageHero titulo={d.titulo} subtitulo={d.resumo} />

  <section class="secao">
    <div class="container">
      <p class="voltar"><a href={url('/projetos/')}>← Todos os projetos</a></p>

      {/* Texto à esquerda, ficha do projeto à direita: o texto ocupa a página em
          vez de ficar numa coluna estreita, e a barra lateral preenche o resto. */}
      <div class="projeto-grade">
        <div class="prosa"><Content /></div>

        <aside class="ficha">
          <h2 class="ficha__titulo">O projeto</h2>
          <dl class="ficha__lista">
            {
              d.status && (
                <div>
                  <dt>Situação</dt>
                  <dd>
                    <span class:list={['etiqueta', d.status === 'ativo' && 'etiqueta--ativo']}>
                      {ROTULO_STATUS[d.status]}
                    </span>
                  </dd>
                </div>
              )
            }
            {
              d.periodo && (
                <div>
                  <dt>Período</dt>
                  <dd>{d.periodo}</dd>
                </div>
              )
            }
          </dl>

          {
            (d.url || d.links.length > 0) && (
              <div class="ficha__acoes">
                {d.url && (
                  <a class="btn btn-primario" href={d.url} target="_blank" rel="noopener noreferrer">
                    {d.rotulo_url ?? 'Acessar o projeto'} <span aria-hidden="true">↗</span>
                  </a>
                )}
                {d.links.map((l) => {
                  const fora = externo(l.url);
                  return (
                    <a
                      class="btn btn-contorno"
                      href={linkPara(l.url)}
                      target={fora ? '_blank' : undefined}
                      rel={fora ? 'noopener noreferrer' : undefined}
                    >
                      {l.rotulo}
                      {fora && <span aria-hidden="true"> ↗</span>}
                    </a>
                  );
                })}
              </div>
            )
          }
        </aside>
      </div>

      {
        d.embed && (
          <div class="painel">
            <iframe
              src={d.embed}
              title={`Painel interativo do projeto ${d.titulo}`}
              loading="lazy"
              allowfullscreen
            />
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .projeto-grade {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--esp-5);
    align-items: start;
  }

  .ficha {
    position: sticky;
    top: calc(var(--esp-5) + 60px);
    background: var(--cor-fundo-alt);
    border-radius: var(--raio-g);
    border-top: 3px solid var(--cor-destaque);
    padding: var(--esp-3);
  }
  .ficha__titulo {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cor-texto-suave);
    margin-bottom: var(--esp-2);
  }
  .ficha__lista {
    margin: 0;
    display: grid;
    gap: var(--esp-2);
  }
  .ficha__lista dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cor-texto-suave);
    margin-bottom: 0.2rem;
  }
  .ficha__lista dd {
    margin: 0;
    font-size: 0.92rem;
  }
  .ficha__acoes {
    margin-top: var(--esp-3);
    padding-top: var(--esp-3);
    border-top: 1px solid var(--cor-borda);
    display: grid;
    gap: var(--esp-2);
  }
  .ficha__acoes .btn {
    text-align: center;
  }

  .painel {
    margin-top: var(--esp-5);
    aspect-ratio: 16 / 10;
    border-radius: var(--raio-g);
    overflow: hidden;
    box-shadow: var(--sombra);
    background: var(--cor-fundo-alt);
  }
  .painel iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .projeto-grade {
      grid-template-columns: 1fr;
      gap: var(--esp-3);
    }
    .ficha {
      position: static;
    }
  }
</style>
