---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FiltrosAcervo from '../components/FiltrosAcervo.astro';
import CardAcervo from '../components/CardAcervo.astro';
import VideoYoutube from '../components/VideoYoutube.astro';
import Titulo from '../components/Titulo.astro';
import { url } from '../lib/url';
import { idItemAcervo } from '../lib/ancoras.mjs';

const pagina = (await getEntry('paginas', 'acervo'))!;
const { Content } = await render(pagina);
const geral = (await getEntry('configuracao', 'geral'))!.data;

const itens = await getCollection('acervo');
// Ordem cronológica estável (o ano vai de 1989 a 1998), depois pelo código.
itens.sort((a, b) => a.data.ano - b.data.ano || a.data.codigo.localeCompare(b.data.codigo));
const total = itens.length;

// Facetas dos filtros, derivadas dos próprios dados (nada fica desatualizado à mão).
const anos = [...new Set(itens.map((i) => i.data.ano))].sort((a, b) => b - a);
const cargos = [...new Set(itens.flatMap((i) => i.data.cargo))].sort((a, b) => a.localeCompare(b));
const regioes = [...new Set(itens.map((i) => i.data.regiao).filter(Boolean) as string[])].sort((a, b) =>
  a.localeCompare(b),
);
const partidos = [...new Set(itens.flatMap((i) => i.data.partidos))].sort((a, b) => a.localeCompare(b));
---

<Base titulo="Acervo Audiovisual" descricao={pagina.data.descricao}>
  <PageHero titulo={pagina.data.titulo} subtitulo={pagina.data.descricao} variante="gradiente" />

  <section class="secao">
    <div class="container">
      <div class="prosa prosa--medida"><Content /></div>

      <div class="acesso" role="note">
        <Titulo nivel="h2" titulo="Como consultar o acervo" class="acesso__titulo" />
        <ul class="acesso__lista">
          <li>
            <span class="acesso__rotulo">Catálogo completo</span>
            <a href={geral.catalogo_acervo} target="_blank" rel="noopener noreferrer">
              Abrir a listagem completa do acervo <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <span class="acesso__rotulo">Formulário de solicitação</span>
            <a href={url(geral.formulario_acervo)} download>
              Baixar o formulário (.docx)
            </a>
          </li>
          <li>
            <span class="acesso__rotulo">Envie o formulário para</span>
            <a href={`mailto:${geral.email}`}>{geral.email}</a>
          </li>
        </ul>
        <p class="acesso__aviso">
          Os vídeos da busca abaixo abrem direto no Google Drive do laboratório. O formulário é
          para pedir o restante do acervo, listado no catálogo completo.
        </p>
        {/* Os vídeos foram para o fim da página, depois da busca. Este atalho é o que
            mantém o documentário — pedido da coordenação — à vista de quem chega. */}
        <p class="acesso__videos">
          <a href="#videos-do-acervo">
            Assista aos vídeos do acervo: os melhores momentos do horário eleitoral e o
            documentário{' '}<cite>Arquitetos do Poder</cite> <span aria-hidden="true">↓</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  {/* A busca vem antes dos vídeos: com eles no meio, os filtros ficavam a 3,3 telas de
      rolagem no celular. */}
  <section class="secao secao--alt" id="buscar-no-acervo">
    <div class="container">
      <Titulo nivel="h2" titulo="Buscar no acervo" />

      <FiltrosAcervo anos={anos} cargos={cargos} regioes={regioes} partidos={partidos} />

      <noscript>
        <p class="noscript-aviso" role="note">
          Os filtros de busca dependem de JavaScript. Sem ele, os {total} itens do acervo são
          exibidos integralmente logo abaixo.
        </p>
      </noscript>

      <p id="contador-acervo" class="contador" aria-live="polite">{total} de {total} itens</p>

      {/* O id de cada item é o que os endereços antigos /acervo-doxa/<slug>/ usam para
          cair direto no card certo (ver src/lib/ancoras.mjs). */}
      <ul class="grade-acervo">
        {
          itens.map((item) => (
            <li id={idItemAcervo(item.data.codigo)}>
              <CardAcervo item={item.data} />
            </li>
          ))
        }
      </ul>

      <p id="sem-resultados" class="sem-resultados" role="status" hidden>
        Nenhum item corresponde aos filtros selecionados. Tente ampliar a busca ou
        <button type="button" id="sem-resultados-limpar" class="link-inline">limpar os filtros</button>.
      </p>
    </div>
  </section>

  {/* Os dois vídeos numa faixa só, lado a lado. Antes eram duas seções inteiras, cada
      uma com texto de um lado e player do outro, empilhadas antes da busca. O de
      melhores momentos veio da home; o documentário vivia escondido como a última
      linha de /na-midia/. */}
  <section class="secao" id="videos-do-acervo">
    <div class="container">
      <Titulo nivel="h2" titulo="Vídeos do acervo" class="titulo-secao" />
      <div class="videos">
        <article class="video">
          <div class="video__moldura">
            <VideoYoutube
              id={geral.video_destaque}
              titulo="Melhores momentos do horário eleitoral"
              miniatura={`/img/video/${geral.video_destaque}.jpg`}
            />
          </div>
          <h3 class="video__titulo">Melhores momentos do horário eleitoral</h3>
          <p class="video__texto">
            Compilação do horário gratuito de propaganda eleitoral do segundo turno das eleições
            presidenciais, montada a partir do acervo audiovisual do laboratório.
          </p>
        </article>

        <article class="video">
          <div class="video__moldura">
            <VideoYoutube
              id={geral.video_documentario}
              titulo="Documentário Arquitetos do Poder"
              miniatura={`/img/video/${geral.video_documentario}.jpg`}
            />
          </div>
          <h3 class="video__titulo">Documentário: Arquitetos do Poder</h3>
          <p class="video__texto">
            Panorama da relação entre mídia e política no Brasil, das campanhas de Getúlio Vargas e
            JK à eleição de 1989, montado a partir de depoimentos e imagens de arquivo.
          </p>
          <p class="video__ficha">
            Coordenação geral de Marcus Figueiredo · Direção e roteiro de Vicente Ferraz e Alessandra
            Aldé · Produção Urca Filmes · 2010, 100 minutos
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>

  .acesso {
    margin-top: var(--esp-3);
    background: color-mix(in srgb, var(--cor-primaria) 6%, white);
    border: 1px solid var(--cor-borda);
    border-left: 4px solid var(--cor-primaria);
    border-radius: var(--raio-g);
    padding: var(--esp-3);
  }
  .acesso__titulo {
    font-size: 1.15rem;
    margin-bottom: var(--esp-2);
  }
  .acesso__lista {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--esp-2);
    display: grid;
    gap: var(--esp-2);
  }
  .acesso__lista li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .acesso__rotulo {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cor-texto-suave);
  }
  .acesso__aviso {
    margin: 0;
    font-size: 0.88rem;
    color: var(--cor-texto-suave);
  }
  .acesso__videos {
    margin: var(--esp-2) 0 0;
    padding-top: var(--esp-2);
    border-top: 1px solid var(--cor-borda);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .acesso__videos cite {
    font-style: italic;
  }

  .noscript-aviso {
    margin-top: var(--esp-2);
    background: color-mix(in srgb, var(--cor-destaque) 12%, white);
    border: 1px solid color-mix(in srgb, var(--cor-destaque) 40%, white);
    border-radius: var(--raio);
    padding: var(--esp-2);
    font-size: 0.9rem;
  }

  .contador {
    margin: var(--esp-3) 0 var(--esp-2);
    font-weight: 600;
    color: var(--cor-texto-suave);
  }

  .grade-acervo {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--esp-3);
  }
  /* Chegou por um endereço antigo (/acervo-doxa/<item>/ → #item-…): o card certo
     fica marcado, senão ele se perde entre os 95. */
  .grade-acervo > li:target :global(.card-acervo) {
    outline: 3px solid var(--cor-destaque);
    outline-offset: 3px;
  }

  .sem-resultados {
    margin-top: var(--esp-3);
    font-size: 0.95rem;
    color: var(--cor-texto-suave);
  }
  .sem-resultados[hidden] {
    display: none;
  }
  .link-inline {
    font: inherit;
    color: var(--cor-primaria);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
  .link-inline:hover {
    color: var(--cor-destaque-texto);
  }

  .videos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--esp-4);
  }
  @media (min-width: 800px) {
    .videos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--esp-4) var(--esp-3);
    }
  }
  .video__moldura {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--raio-g);
    overflow: hidden;
    box-shadow: var(--sombra);
  }
  .video__titulo {
    margin: var(--esp-2) 0 var(--esp-1);
  }
  .video__texto {
    margin: 0;
    color: var(--cor-texto-suave);
  }
  /* Ficha técnica do documentário: menor e mais leve que o texto de apoio. */
  .video__ficha {
    margin: var(--esp-1) 0 0;
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
  }
</style>

<script>
  // Filtro multi-faceta 100% client-side. Todos os cards já estão no HTML (SSG); aqui apenas
  // escondemos os que não casam. Assim, sem JS, tudo aparece e nada se perde.
  import { normalizar, casaBusca } from '../lib/texto';

  const busca = document.getElementById('filtro-busca') as HTMLInputElement | null;
  const ano = document.getElementById('filtro-ano') as HTMLSelectElement | null;
  const cargo = document.getElementById('filtro-cargo') as HTMLSelectElement | null;
  const regiao = document.getElementById('filtro-regiao') as HTMLSelectElement | null;
  const partido = document.getElementById('filtro-partido') as HTMLSelectElement | null;
  const limpar = document.getElementById('filtro-limpar');
  const limparVazio = document.getElementById('sem-resultados-limpar');
  const contador = document.getElementById('contador-acervo');
  const semResultados = document.getElementById('sem-resultados');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card-acervo'));
  const total = cards.length;

  /** Destaca, no card, os candidatos que casaram com a busca. */
  function destacarCandidatos(card: HTMLElement, consulta: string) {
    const nomes = Array.from(card.querySelectorAll<HTMLElement>('.card-acervo__candidato'));
    const termos = normalizar(consulta).split(/\s+/).filter(Boolean);
    // Primeiro, quem casa com a busca inteira ("paulo maluf" destaca só Paulo Maluf).
    let algum = false;
    for (const n of nomes) {
      const casa = termos.length > 0 && casaBusca(n.dataset.nome ?? '', consulta);
      n.classList.toggle('is-match', casa);
      algum ||= casa;
    }
    // Se ninguém casa sozinho ("lula brizola" junta dois candidatos), destaca cada termo.
    if (termos.length > 0 && !algum) {
      for (const n of nomes) {
        n.classList.toggle('is-match', termos.some((t) => casaBusca(n.dataset.nome ?? '', t)));
      }
    }
  }

  /** Com filtro de partido, abre a lista de partidos do card e marca a sigla. */
  function destacarPartido(card: HTMLElement, fPartido: string, visivel: boolean) {
    const bloco = card.querySelector<HTMLDetailsElement>('.card-acervo__partidos');
    if (!bloco) return;
    bloco.querySelectorAll<HTMLElement>('li').forEach((li) => {
      li.classList.toggle('is-match', fPartido !== '' && li.dataset.partido === fPartido);
    });
    if (fPartido && visivel) {
      if (!bloco.open) {
        bloco.open = true;
        bloco.dataset.abertoPeloFiltro = 'sim';
      }
    } else if (bloco.dataset.abertoPeloFiltro) {
      // só fecha o que o filtro abriu; o que a pessoa abriu à mão fica aberto
      bloco.open = false;
      delete bloco.dataset.abertoPeloFiltro;
    }
  }

  if (busca && ano && cargo && regiao && partido && contador && semResultados) {
    const aplicar = () => {
      const fAno = ano.value;
      const fCargo = cargo.value;
      const fRegiao = regiao.value;
      const fPartido = partido.value;
      let visiveis = 0;

      for (const card of cards) {
        const cargos = (card.dataset.cargo ?? '').split('|');
        const partidos = (card.dataset.partidos ?? '').split('|');
        const okAno = !fAno || card.dataset.ano === fAno;
        const okCargo = !fCargo || cargos.includes(fCargo);
        const okRegiao = !fRegiao || card.dataset.regiao === fRegiao;
        const okPartido = !fPartido || partidos.includes(fPartido);
        const okBusca = casaBusca(card.dataset.candidatos ?? '', busca.value);
        const mostrar = okAno && okCargo && okRegiao && okPartido && okBusca;
        // Esconder o <li>, não só o card: escondendo o card a célula da grade
        // continuava ocupando espaço, e com 0 resultados sobravam 744px (desktop)
        // ou 2.256px (celular) de branco antes da mensagem "nenhum item".
        (card.parentElement ?? card).hidden = !mostrar;
        if (mostrar) visiveis++;
        destacarCandidatos(card, busca.value);
        destacarPartido(card, fPartido, mostrar);
      }

      contador.textContent = `${visiveis} de ${total} itens`;
      semResultados.hidden = visiveis !== 0;
    };

    const reiniciar = () => {
      busca.value = '';
      ano.value = '';
      cargo.value = '';
      regiao.value = '';
      partido.value = '';
      aplicar();
    };

    for (const el of [busca, ano, cargo, regiao, partido]) {
      el.addEventListener('input', aplicar);
      el.addEventListener('change', aplicar);
    }
    limpar?.addEventListener('click', reiniciar);
    limparVazio?.addEventListener('click', reiniciar);

    // Filtros vindos da URL (?candidato=collor&ano=1989…). É assim que os endereços
    // antigos do WordPress — /candidatos-presidente/…, /partidos/…, /ano/… — chegam
    // já filtrados. Valores de select casam pela forma normalizada.
    const params = new URLSearchParams(location.search);
    let veioFiltrado = false;
    const candidato = params.get('candidato');
    if (candidato) {
      busca.value = candidato;
      veioFiltrado = true;
    }
    for (const [nome, campo] of [
      ['ano', ano],
      ['cargo', cargo],
      ['regiao', regiao],
      ['partido', partido],
    ] as const) {
      const valor = params.get(nome);
      if (!valor) continue;
      const alvo = normalizar(valor);
      const opcao = Array.from(campo.options).find(
        (o) => o.value !== '' && (o.value === alvo || normalizar(o.textContent ?? '') === alvo),
      );
      if (opcao) {
        campo.value = opcao.value;
        veioFiltrado = true;
      }
    }

    aplicar();

    if (veioFiltrado && !location.hash) {
      document.getElementById('buscar-no-acervo')?.scrollIntoView();
    }
  }
</script>
