---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CardMembro from '../components/CardMembro.astro';
import Titulo from '../components/Titulo.astro';

const pagina = (await getEntry('paginas', 'institucional'))!;
const { Content } = await render(pagina);
const geral = (await getEntry('configuracao', 'geral'))!.data;

const equipe = await getCollection('equipe');

/**
 * As categorias deixaram de ser LAYOUT e viraram INFORMAÇÃO.
 *
 * Antes, cada uma das seis ganhava uma seção de página inteira, com título e
 * faixa de fundo alternada — e quatro delas têm uma ou duas pessoas, então
 * sobravam três ou quatro colunas vazias por fileira. Agora é uma grade só, na
 * ordem que o campo `ordem` já codifica (coordenação primeiro), e a função vai
 * numa etiqueta dentro do card: 16 pessoas em 4 fileiras cheias, e o layout não
 * quebra quando a equipe muda de tamanho.
 */
const FUNCOES: Record<string, string> = {
  coordenacao: 'Coordenação',
  pesquisadores: 'Pesquisador',
  'pos-doutorando': 'Pós-doutorado',
  aluno: 'Pós-graduação',
  assistente: 'Assistente',
  associado: 'Pesquisador associado',
};

const membros = [...equipe]
  .sort(
    (a, b) =>
      (a.data.ordem ?? 999) - (b.data.ordem ?? 999) ||
      a.data.nome.localeCompare(b.data.nome, 'pt-BR'),
  )
  .map((m) => ({ ...m.data, funcao: FUNCOES[m.data.categoria] ?? '' }));
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao}>
  <PageHero titulo={pagina.data.titulo} subtitulo={pagina.data.descricao} variante="gradiente" />

  <section class="secao">
    <div class="container">
      <div class="prosa">
        <Content />
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <Titulo nivel="h2" titulo="Nossa Equipe" classe="titulo-secao" />
      <ul class="equipe-grid">
        {
          membros.map((m) => (
            <CardMembro
              nome={m.nome}
              cargo={m.cargo}
              funcao={m.funcao}
              foto={m.foto}
              lattes={m.lattes}
              site={m.site}
              email={m.email}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao secao--alt contato">
    <div class="container">
      <h2>Contato</h2>
      <dl class="contato__lista">
        <div class="contato__item">
          <dt>E-mail</dt>
          <dd><a href={`mailto:${geral.email}`}>{geral.email}</a></dd>
        </div>
        <div class="contato__item">
          <dt>Endereço</dt>
          <dd>{geral.endereco}<br />CEP {geral.cep}</dd>
        </div>
        {
          geral.youtube && (
            <div class="contato__item">
              <dt>YouTube</dt>
              <dd>
                <a href={geral.youtube} target="_blank" rel="noopener noreferrer">
                  Canal do DOXA
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>
</Base>

<style>

  .equipe-grid {
    display: grid;
    /* 240px dá 4 colunas a 1440px — 16 pessoas em 4 fileiras cheias. */
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: var(--esp-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* Duas colunas no celular: com uma só, apresentar 16 pessoas custava 11 telas
     de rolagem. É esta linha que corta a maior parte disso. */
  @media (max-width: 700px) {
    .equipe-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--esp-2);
    }
  }

  .contato__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--esp-3);
    margin: 0;
  }
  .contato__item {
    background: var(--cor-fundo-alt);
    border-radius: var(--raio-g);
    padding: var(--esp-3);
  }
  .contato__item dt {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
    /* sobre --cor-fundo-alt, --cor-destaque dá 3,38:1 e reprova em AA */
    color: var(--cor-destaque-texto);
    margin-bottom: var(--esp-1);
  }
  .contato__item dd {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
