---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardDestaque from '../components/CardDestaque.astro';
import { url } from '../lib/url';

const home = (await getEntry('paginas', 'home'))!;
const { Content } = await render(home);

const [parceiros, pesquisas, publicacoes, acervo, mapas, todosDestaques] = await Promise.all([
  getCollection('parceiros'),
  getCollection('pesquisas'),
  getCollection('publicacoes'),
  getCollection('acervo'),
  getCollection('mapas'),
  getCollection('destaques'),
]);

// Vitrine curada pela coordenação (src/content/destaques/). `ativo: false`
// arquiva um destaque sem apagar o arquivo.
const emDestaque = todosDestaques
  .filter((d) => d.data.ativo)
  .sort((a, b) => (a.data.ordem ?? 99) - (b.data.ordem ?? 99));

// Atalhos fixos para as quatro seções — não confundir com `emDestaque`, que é a
// vitrine curada logo acima. A home é a APRESENTAÇÃO INSTITUCIONAL do grupo
// (docs/DECISAO_ARQUITETURA.md §6): o Vota Aí, o vídeo e o dashboard saíram daqui
// e viraram projetos (/projetos/) e conteúdo do acervo (/acervo/).
const atalhos = [
  {
    titulo: 'Produção',
    texto: 'Teses, dissertações, publicações acadêmicas, análises de conjuntura e working papers.',
    href: '/producao/',
    cta: 'Ver a produção',
  },
  {
    titulo: 'Projetos',
    texto: 'Plataformas, painéis e pesquisas aplicadas, como o Vota Aí e a Geografia do Voto.',
    href: '/projetos/',
    cta: 'Ver os projetos',
  },
  {
    titulo: 'Acervo Audiovisual',
    texto: 'O maior arquivo de propaganda eleitoral do Brasil, com programas desde 1989.',
    href: '/acervo/',
    cta: 'Explorar o acervo',
  },
  {
    titulo: 'Bancos de Dados',
    texto: 'Bases abertas sobre programas de governo, cobertura jornalística e mapas eleitorais.',
    href: '/bancos-de-dados/',
    cta: 'Ver as bases',
  },
];

// Contagens vindas das coleções — nenhum número escrito à mão para envelhecer.
const numeros = [
  { valor: new Date().getFullYear() - 1996, rotulo: 'anos de pesquisa' },
  { valor: acervo.length, rotulo: 'itens no acervo' },
  { valor: pesquisas.length, rotulo: 'pesquisas' },
  { valor: publicacoes.length, rotulo: 'publicações' },
  { valor: mapas.length, rotulo: 'mapas eleitorais' },
];
---

<Base titulo="DOXA" descricao={home.data.descricao}>
  <section class="apresentacao">
    <div class="container">
      <p class="olho">IESP-UERJ · desde 1996</p>
      <h1>{home.data.subtitulo}</h1>
      {/* Texto de ponta a ponta, em duas colunas: preenche a página sem produzir
          linhas longas demais para ler. */}
      <div class="prosa prosa--colunas apresentacao__texto"><Content /></div>
    </div>
  </section>

  {
    emDestaque.length > 0 && (
      <section class="secao secao--destaques">
        <div class="container">
          <h2 class="titulo-secao">Em destaque</h2>
          <ul class="destaques">
            {emDestaque.map((d) => (
              <CardDestaque
                titulo={d.data.titulo}
                resumo={d.data.resumo}
                etiqueta={d.data.etiqueta}
                imagem={d.data.imagem}
                url={d.data.url}
                rotulo_url={d.data.rotulo_url}
              />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="secao secao--alt">
    <div class="container">
      <h2>O que fazemos</h2>
      <ul class="grade-cards">
        {
          atalhos.map((d) => (
            <li class="cartao">
              <h3 class="cartao__titulo">{d.titulo}</h3>
              <p class="cartao__texto">{d.texto}</p>
              <a href={url(d.href)} class="cartao__link">
                {d.cta} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="numeros faixa-marca textura-x">
    <div class="container">
      <h2 class="numeros__titulo">O DOXA em números</h2>
      <ul class="numeros__lista">
        {
          numeros.map((n) => (
            <li>
              <span class="numeros__valor">{n.valor}</span>
              <span class="numeros__rotulo">{n.rotulo}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <h2 class="parceiros__titulo">Apoio e parcerias</h2>
      <ul class="parceiros">
        {
          parceiros.map((p) => (
            <li>
              <img
                src={url(p.data.arquivo)}
                alt={`Logotipo ${p.data.nome}`}
                loading="lazy"
                height="56"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* 4 cards em 3 colunas deixavam um sozinho com 2/3 da fileira vazia.
     250px dá 4 colunas a 1440px — o hook --card-min existe para isto. */
  .grade-cards {
    --card-min: 250px;
  }
  .apresentacao {
    padding-block: var(--esp-5) var(--esp-4);
  }
  /* Vitrine de destaques: cards deitados, duas colunas a partir de 900px. Não uso
     .grade-cards porque estes cards são horizontais e precisam de mais largura. */
  .destaques {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* minmax(0, 1fr), não só `gap`: o tamanho mínimo automático do item de grade
       (min-width: auto) impede o card de encolher abaixo do próprio min-content,
       e ele estoura a tela em celular estreito. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--esp-3);
  }
  @media (min-width: 900px) {
    .destaques {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Título corrido: ocupa a largura da página, como o texto abaixo. */
  .apresentacao h1 {
    margin-bottom: var(--esp-3);
    text-wrap: balance;
  }
  .apresentacao__texto {
    font-size: 1.02rem;
  }

  .cartao__titulo {
    margin-bottom: var(--esp-1);
  }
  .cartao__texto {
    color: var(--cor-texto-suave);
    font-size: 0.92rem;
    flex: 1;
  }
  .cartao__link {
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    margin-top: auto;
  }

  .numeros {
    padding-block: var(--esp-4);
  }
  .numeros__titulo {
    text-align: center;
    margin-bottom: var(--esp-3);
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.9;
  }
  .numeros__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--esp-3);
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }
  .numeros__valor {
    display: block;
    font-size: clamp(1.8rem, 1.2rem + 1.8vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--cor-destaque-claro);
  }
  .numeros__rotulo {
    display: block;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    opacity: 0.9;
  }

  .parceiros__titulo {
    text-align: center;
  }
  .parceiros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--esp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .parceiros img {
    height: 56px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
    transition: var(--transicao);
  }
  .parceiros img:hover {
    filter: none;
    opacity: 1;
  }

</style>
