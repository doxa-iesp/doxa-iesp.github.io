---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BocaDeJacare from '../components/BocaDeJacare.astro';
import { url } from '../lib/url';

const home = (await getEntry('paginas', 'home'))!;
const { Content } = await render(home);

const [parceiros, pesquisas, publicacoes, acervo, mapas] = await Promise.all([
  getCollection('parceiros'),
  getCollection('pesquisas'),
  getCollection('publicacoes'),
  getCollection('acervo'),
  getCollection('mapas'),
]);

// A home é a APRESENTAÇÃO INSTITUCIONAL do grupo (docs/DECISAO_ARQUITETURA.md §6).
// O Vota Aí, o vídeo e o dashboard saíram daqui: viraram projetos (/projetos/) e
// conteúdo do acervo (/acervo/).
const destaques = [
  {
    titulo: 'Produção',
    texto: 'Teses, dissertações, publicações acadêmicas, análises de conjuntura e working papers.',
    href: '/producao/',
  },
  {
    titulo: 'Projetos',
    texto: 'Plataformas, painéis e pesquisas aplicadas — como o Vota Aí e a Geografia do Voto.',
    href: '/projetos/',
  },
  {
    titulo: 'Acervo Audiovisual',
    texto: 'O maior arquivo de propaganda eleitoral do Brasil, com programas desde 1989.',
    href: '/acervo/',
  },
  {
    titulo: 'Bancos de Dados',
    texto: 'Bases abertas sobre programas de governo, cobertura jornalística e mapas eleitorais.',
    href: '/bancos-de-dados/',
  },
];

// Contagens vindas das coleções — nenhum número escrito à mão para envelhecer.
const numeros = [
  { valor: new Date().getFullYear() - 1996, rotulo: 'anos de pesquisa' },
  { valor: acervo.length, rotulo: 'itens no acervo' },
  { valor: pesquisas.length, rotulo: 'pesquisas' },
  { valor: publicacoes.length, rotulo: 'publicações' },
  { valor: mapas.length, rotulo: 'mapas eleitorais' },
];
---

<Base titulo="DOXA" descricao={home.data.descricao}>
  <section class="apresentacao">
    <div class="container apresentacao__grade">
      <div>
        <p class="olho">IESP-UERJ · desde 1996</p>
        <h1>{home.data.subtitulo}</h1>
        <div class="prosa prosa--coluna"><Content /></div>
      </div>

      <div class="apresentacao__arte">
        <BocaDeJacare />
        <p class="apresentacao__legenda">
          <strong>Boca de jacaré:</strong> o cruzamento das curvas de intenção de voto — o momento
          que o laboratório estuda desde 1996.
        </p>
      </div>
    </div>
  </section>

  <section class="secao secao--alt">
    <div class="container">
      <h2>O que fazemos</h2>
      <ul class="grade-cards">
        {
          destaques.map((d) => (
            <li class="cartao">
              <h3 class="cartao__titulo">{d.titulo}</h3>
              <p class="cartao__texto">{d.texto}</p>
              <a href={url(d.href)} class="cartao__link">
                Conhecer <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="numeros faixa-marca textura-x">
    <div class="container">
      <h2 class="numeros__titulo">O DOXA em números</h2>
      <ul class="numeros__lista">
        {
          numeros.map((n) => (
            <li>
              <span class="numeros__valor">{n.valor}</span>
              <span class="numeros__rotulo">{n.rotulo}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <h2 class="parceiros__titulo">Apoio e parcerias</h2>
      <ul class="parceiros">
        {
          parceiros.map((p) => (
            <li>
              <img
                src={url(p.data.arquivo)}
                alt={`Logotipo ${p.data.nome}`}
                loading="lazy"
                height="56"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .apresentacao {
    padding-block: var(--esp-5) var(--esp-4);
  }
  /* Texto à esquerda, ilustração à direita: o vazio que sobrava à direita da
     prosa agora tem conteúdo — e é conteúdo que fala do que o DOXA estuda. */
  .apresentacao__grade {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: var(--esp-5);
    align-items: center;
  }
  .apresentacao h1 {
    max-width: 18ch;
  }
  .apresentacao__legenda {
    margin: var(--esp-2) 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--cor-texto-suave);
  }
  .apresentacao__legenda strong {
    color: var(--cor-destaque-texto);
  }

  .cartao__titulo {
    margin-bottom: var(--esp-1);
  }
  .cartao__texto {
    color: var(--cor-texto-suave);
    font-size: 0.92rem;
    flex: 1;
  }
  .cartao__link {
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    margin-top: auto;
  }

  .numeros {
    padding-block: var(--esp-4);
  }
  .numeros__titulo {
    text-align: center;
    margin-bottom: var(--esp-3);
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.9;
  }
  .numeros__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--esp-3);
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }
  .numeros__valor {
    display: block;
    font-size: clamp(1.8rem, 1.2rem + 1.8vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--cor-destaque-claro);
  }
  .numeros__rotulo {
    display: block;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    opacity: 0.9;
  }

  .parceiros__titulo {
    text-align: center;
  }
  .parceiros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--esp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .parceiros img {
    height: 56px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
    transition: var(--transicao);
  }
  .parceiros img:hover {
    filter: none;
    opacity: 1;
  }

  @media (max-width: 900px) {
    .apresentacao__grade {
      grid-template-columns: 1fr;
      gap: var(--esp-3);
    }
    .apresentacao h1 {
      max-width: none;
    }
  }
</style>
