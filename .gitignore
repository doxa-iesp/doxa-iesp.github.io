# Este arquivo já foi um template de Python, e a regra `lib/` engolia src/lib/ —
# o build quebrou no CI porque src/lib/url.ts nunca chegou ao repositório.
# Mantenha as regras ANCORADAS na raiz (com `/` na frente) para não repetir o erro.

# Astro / Node
/node_modules/
/dist/
/.astro/

# Python (os scripts em scripts/ são Python)
__pycache__/
*.py[cod]
/.venv/
/venv/

# Sistema operacional
.DS_Store
Thumbs.db

# Cópias que o iCloud cria ao sincronizar (duplicariam entradas no build)
* 2.*
* 2 *

# Segredos e logs locais
.env
.env.*
!.env.example
*.log

# ATENÇÃO: `public/` NÃO é ignorado. No Hugo era a saída de build; no Astro é a
# pasta de ASSETS DE ORIGEM (imagens, fontes, PDFs, CSVs) e PRECISA ser versionada,
# senão o deploy publica o site sem imagens.
